---
import SiteLayout from '../layouts/SiteLayout.astro';
import { profile } from '../shared/config/profile';
import { PHOTO_MOEBIUS_TRUSS_SET } from '../shared/media/frontImages';
import ResponsivePicture from '../shared/ui/ResponsivePicture.astro';
---

<SiteLayout title="AKIRA // CONTATO" stage="607758" currentPage="contato">
  <!-- Quadro Split Half-Blur com a Arte 607758 (Moebius) sobre o Átrio Desfocado 607758 -->
  <section class="split-photo-stage min-h-[460px] sm:min-h-[520px] flex items-end md:items-center p-6 sm:p-10 lg:p-14">
    <ResponsivePicture
      image={PHOTO_MOEBIUS_TRUSS_SET}
      alt="607758 MOEBIUS STAGE"
      fetchpriority="high"
      loading="eager"
      width={1280}
      height={720}
      class="split-photo-sharp object-cover object-center"
    />
    <div class="split-lens-left" aria-hidden="true"></div>

    <div class="relative z-10 w-full max-w-md space-y-6">
      <div class="space-y-2">
        <p class="font-mono text-xs text-on-surface-variant tracking-widest">
          04 // CONEXÃO
        </p>
        <h1 class="headline-bicolor text-3xl sm:text-5xl">
          <span class="headline-bicolor-primary">CANAL</span>
          <span class="headline-bicolor-secondary">DIRETO.</span>
        </h1>
      </div>

      <!-- E-mail Copiável em 1 Clique -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
        <div class="px-4 py-2.5 border border-outline-variant bg-surface-container-lowest font-mono text-xs text-on-surface break-all">
          AKIRA.ENG@PROTON.ME
        </div>

        <button
          type="button"
          id="copyEmailBtn"
          data-email="akira.eng@proton.me"
          class="px-5 py-2.5 border border-on-surface bg-on-surface text-background font-mono text-xs font-bold cursor-pointer hover:opacity-90 transition-opacity shrink-0"
        >
          <span id="copyEmailLabel">COPIAR</span>
        </button>
      </div>

      <!-- Links Diretos -->
      <div class="pt-4 border-t border-outline-variant flex flex-wrap items-center gap-6">
        {profile.socials.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="editorial-link"
          >
            <span>{s.label}</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>

<script is:inline>
  (() => {
    const btn = document.getElementById('copyEmailBtn');
    const label = document.getElementById('copyEmailLabel');
    if (!btn || !label) return;

    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email') || 'akira.eng@proton.me';
      try {
        await navigator.clipboard.writeText(email);
        label.textContent = 'COPIADO ✓';
        setTimeout(() => {
          label.textContent = 'COPIAR';
        }, 2200);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  })();
</script>
