---
import SiteLayout from '../layouts/SiteLayout.astro';
import { profile } from '../shared/config/profile';
---

<SiteLayout title="AKIRA // CONTATO" stage="607758" currentPage="contato">
  <!-- Canal de Contato Direto (Sem Numerações, Sem Cards Clunky) -->
  <section class="max-w-xl space-y-8">
    <div class="space-y-3">
      <p class="font-mono text-xs text-on-surface-variant tracking-[0.22em]">
        COMUNICAÇÃO & REDES
      </p>
      <h1 class="headline-serif text-3xl sm:text-5xl">
        <span class="headline-serif-primary">CANAL</span>
        <span class="headline-serif-secondary">DIRETO.</span>
      </h1>
      <p class="font-mono text-xs text-on-surface-variant leading-relaxed">
        DISPONÍVEL PARA ARQUITETURA DE SISTEMAS, CONSULTORIA TÉCNICA E DESENVOLVIMENTO DE PROJETOS DE ALTO DESEMPENHO.
      </p>
    </div>

    <!-- E-mail Copiável em 1 Clique -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
      <div class="px-5 py-3 border border-outline-variant/60 bg-surface-container-lowest font-mono text-xs text-on-surface tracking-wider break-all">
        AKIRA.ENG@PROTON.ME
      </div>

      <button
        type="button"
        id="copyEmailBtn"
        data-email="akira.eng@proton.me"
        class="px-6 py-3 border border-on-surface bg-on-surface text-background font-mono text-xs font-bold tracking-widest cursor-pointer hover:opacity-90 transition-opacity shrink-0"
      >
        <span id="copyEmailLabel">COPIAR</span>
      </button>
    </div>

    <!-- Links Diretos Sociais -->
    <div class="pt-6 border-t border-outline-variant/40 flex flex-wrap items-center gap-8 sm:gap-10">
      {profile.socials.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-link"
        >
          <span>{s.label}</span>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>

<script is:inline>
  (() => {
    const btn = document.getElementById('copyEmailBtn');
    const label = document.getElementById('copyEmailLabel');
    if (!btn || !label) return;

    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email') || 'akira.eng@proton.me';
      try {
        await navigator.clipboard.writeText(email);
        label.textContent = 'COPIADO ✓';
        setTimeout(() => {
          label.textContent = 'COPIAR';
        }, 2200);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  })();
</script>
