---
import SiteLayout from '../layouts/SiteLayout.astro';
import { profile } from '../shared/config/profile';
---

<SiteLayout title="AKIRA // CONTATO" stage="607758" currentPage="contato">
  <!-- Conteúdo Direto sobre o Átrio 607758 (Moebius) em Tela Cheia (Sem Card) -->
  <section class="max-w-lg space-y-8">
    <div class="space-y-3">
      <p class="font-mono text-xs text-on-surface-variant tracking-widest">
        04 // CONEXÃO
      </p>
      <h1 class="headline-bicolor text-4xl sm:text-6xl">
        <span class="headline-bicolor-primary">CANAL</span>
        <span class="headline-bicolor-secondary">DIRETO.</span>
      </h1>
    </div>

    <!-- E-mail Copiável em 1 Clique -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
      <div class="px-4 py-2.5 border border-outline-variant bg-surface-container-lowest font-mono text-xs text-on-surface break-all">
        AKIRA.ENG@PROTON.ME
      </div>

      <button
        type="button"
        id="copyEmailBtn"
        data-email="akira.eng@proton.me"
        class="px-5 py-2.5 border border-on-surface bg-on-surface text-background font-mono text-xs font-bold cursor-pointer hover:opacity-90 transition-opacity shrink-0"
      >
        <span id="copyEmailLabel">COPIAR</span>
      </button>
    </div>

    <!-- Links Diretos -->
    <div class="pt-6 border-t border-outline-variant flex flex-wrap items-center gap-8">
      {profile.socials.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-link"
        >
          <span>{s.label}</span>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>

<script is:inline>
  (() => {
    const btn = document.getElementById('copyEmailBtn');
    const label = document.getElementById('copyEmailLabel');
    if (!btn || !label) return;

    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email') || 'akira.eng@proton.me';
      try {
        await navigator.clipboard.writeText(email);
        label.textContent = 'COPIADO ✓';
        setTimeout(() => {
          label.textContent = 'COPIAR';
        }, 2200);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  })();
</script>
