---
import SiteLayout from '../layouts/SiteLayout.astro';
import { profile } from '../shared/config/profile';
---

<SiteLayout title="AKIRA // CONTATO" stage="607758" currentPage="contato">
  <!-- Canal de Contato Direto Responsivo -->
  <section class="w-full max-w-xl space-y-6 sm:space-y-8 min-w-0">
    <div class="space-y-2.5 sm:space-y-3 min-w-0">
      <h1 class="headline-serif">
        <span class="headline-serif-primary">CONTATO.</span>
      </h1>
      <p class="font-mono text-xs text-on-surface-variant tracking-wider break-words">
        {profile.intro.opportunity}
      </p>
    </div>

    <!-- E-mail Copiável em 1 Clique (Empilhado em Mobile, Lado a Lado em Telas Maiores) -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 min-w-0">
      <div class="px-4 sm:px-5 py-3 border border-outline-variant/60 bg-surface-container-lowest font-mono text-xs text-on-surface tracking-wider break-all text-center sm:text-left">
        AKIRA.ENG@PROTON.ME
      </div>

      <button
        type="button"
        id="copyEmailBtn"
        data-email="akira.eng@proton.me"
        class="px-6 py-3 border border-on-surface bg-on-surface text-background font-mono text-xs font-bold tracking-widest cursor-pointer hover:opacity-90 transition-opacity shrink-0 text-center"
      >
        <span id="copyEmailLabel">COPIAR</span>
      </button>
    </div>

    <!-- Links Sociais Diretos (Alvos de Toque Confortáveis em Mobile) -->
    <div class="pt-5 sm:pt-6 border-t border-outline-variant/40 flex flex-wrap items-center gap-6 sm:gap-10 font-mono text-xs">
      {profile.socials.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-link py-1"
        >
          <span>{s.label}</span>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>

<script is:inline>
  (() => {
    const btn = document.getElementById('copyEmailBtn');
    const label = document.getElementById('copyEmailLabel');
    if (!btn || !label) return;

    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email') || 'akira.eng@proton.me';
      try {
        await navigator.clipboard.writeText(email);
        label.textContent = 'COPIADO ✓';
        setTimeout(() => {
          label.textContent = 'COPIAR';
        }, 2200);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  })();
</script>
