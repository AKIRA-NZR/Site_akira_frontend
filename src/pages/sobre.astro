---
import SiteLayout from '../layouts/SiteLayout.astro';
import { profile } from '../shared/config/profile';
import ToolIcon from '../shared/ui/ToolIcon.astro';
import InteractiveTerminal from '../shared/ui/InteractiveTerminal.astro';
---

<SiteLayout title="AKIRA // SOBRE" stage="902085" currentPage="sobre">
  <div class="space-y-12 sm:space-y-16 min-w-0 max-w-6xl">
    <!-- Cabeçalho com Espaçamento Amplo e Blend-Mode Difference no Título -->
    <header data-motion-item class="space-y-4 sm:space-y-5 min-w-0">
      <h1 class="headline-serif">
        <span class="headline-serif-primary">{profile.about.title}</span>
      </h1>

      <p class="font-mono text-xs sm:text-sm text-on-surface-variant leading-relaxed max-w-2xl break-words">
        {profile.about.description}
      </p>
    </header>

    <!-- Grade de Ferramentas com Interatividade Motion & Spotlight -->
    <section data-motion-item class="space-y-5 sm:space-y-6 pt-8 sm:pt-10 border-t border-outline-variant/35 min-w-0">
      <p class="font-mono text-[10px] sm:text-xs text-on-surface-variant tracking-[0.2em]">
        FERRAMENTAS & AMBIENTE DE TRABALHO
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 sm:gap-4">
        {profile.tools.map((tool) => (
          <div
            data-motion-item
            class="refined-card p-3.5 sm:p-4 flex items-center gap-3 group min-w-0"
          >
            <div class="text-on-surface-variant group-hover:text-on-surface transition-colors shrink-0">
              <ToolIcon name={tool.icon} class="h-4 w-4 sm:h-5 sm:w-5" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="font-mono text-[11px] sm:text-xs font-semibold text-on-surface tracking-wider break-words leading-tight">
                {tool.name}
              </div>
              <div class="font-mono text-[9px] text-on-surface-variant tracking-wider break-words opacity-75 mt-1 leading-tight">
                {tool.category}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Pilares de Foco Integrados ao Terminal Real Xterm.js -->
    <section data-motion-item class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start pt-8 sm:pt-10 border-t border-outline-variant/35 min-w-0">
      <!-- Terminal Interativo Real (Xterm.js) -->
      <div class="lg:col-span-6 min-w-0">
        <InteractiveTerminal mode="sobre" />
      </div>

      <!-- Lista dos 4 Pilares (Passar o mouse ou clicar executa comando real no Terminal) -->
      <div class="lg:col-span-6 min-w-0">
        <div
          id="swissFocusList"
          class="swiss-focus-list divide-y divide-outline-variant/40 border-y border-outline-variant/40"
        >
          {profile.corePrinciples.map((item, idx) => (
            <article
              data-swiss-row={idx}
              tabindex="0"
              class="swiss-focus-row group py-5 sm:py-6 flex items-center justify-between gap-4 cursor-pointer focus-visible:outline-none min-w-0"
            >
              <div class="space-y-1.5 min-w-0">
                <h2 class="font-display text-sm sm:text-base lg:text-lg font-bold text-on-surface group-hover:text-accent-stage transition-colors tracking-[0.12em] sm:tracking-[0.16em] break-words">
                  {item.title}
                </h2>
                <p class="font-mono text-[10px] sm:text-xs text-on-surface-variant break-words tracking-wider">
                  {item.subtitle}
                </p>
              </div>
              <span class="font-mono text-xs text-on-surface-variant/40 group-hover:text-accent-stage group-hover:translate-x-1 transition-all shrink-0" aria-hidden="true">
                ❯
              </span>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</SiteLayout>

<script is:inline>
  (() => {
    const list = document.getElementById('swissFocusList');
    if (!list) return;

    const rows = list.querySelectorAll('[data-swiss-row]');
    let lastTriggered = -1;

    rows.forEach((row) => {
      const idx = Number(row.getAttribute('data-swiss-row'));
      const triggerPillar = () => {
        if (lastTriggered === idx) return;
        lastTriggered = idx;
        window.dispatchEvent(
          new CustomEvent('akira:terminal-exec', {
            detail: { cmd: `pillar ${idx}` },
          })
        );
      };
      row.addEventListener('mouseenter', triggerPillar);
      row.addEventListener('click', () => {
        lastTriggered = -1;
        triggerPillar();
      });
    });
  })();
</script>
