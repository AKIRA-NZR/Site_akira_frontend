---
import SiteLayout from '../layouts/SiteLayout.astro';
import { profile } from '../shared/config/profile';
import ResponsivePicture from '../shared/ui/ResponsivePicture.astro';
import { withBase } from '../shared/routing/paths';
---

<SiteLayout title="AKIRA // SOBRE" stage="902085" currentPage="sobre">
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
    <!-- Coluna 4/12: Título + Stack Enxuta + Preview Flutuante Sem Cantos Arredondados -->
    <div class="lg:col-span-4 space-y-8 min-w-0">
      <div>
        <p class="font-mono text-xs text-on-surface-variant tracking-widest mb-2">
          02 // ENGENHARIA
        </p>
        <h1 class="headline-bicolor text-3xl sm:text-5xl">
          <span class="headline-bicolor-primary">PILARES</span>
          <span class="headline-bicolor-secondary">& NÚCLEO.</span>
        </h1>
      </div>

      <!-- Stack Core em Vidro Fumê Ultracompacto (Zero Comparações) -->
      <div class="stage-glass-panel p-4 grid grid-cols-2 gap-2 font-mono text-xs">
        {profile.stack.map((tech) => (
          <div class="flex items-center justify-between px-2.5 py-1.5 border border-outline-variant bg-surface-container-lowest">
            <span class="font-semibold text-on-surface">{tech.name}</span>
            <span class="text-on-surface-variant text-[10px]">{tech.version}</span>
          </div>
        ))}
      </div>

      <!-- Container Flutuante Periférico Sem Cantos Arredondados (rounded-none) -->
      <div
        id="swissPreviewContainer"
        aria-hidden="true"
        class="hidden lg:block pointer-events-none opacity-0 translate-y-2 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
      >
        <div class="rounded-none border border-outline bg-surface-container-lowest p-2">
          <div class="relative aspect-[16/10] w-full overflow-hidden rounded-none bg-background">
            {profile.corePrinciples.map((item, idx) => (
              <div
                data-swiss-preview-slide={idx}
                class:list={[
                  'absolute inset-0 transition-opacity duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]',
                  idx === 0 ? 'opacity-100' : 'opacity-0',
                ]}
              >
                <ResponsivePicture
                  image={item.previewImage}
                  alt={item.title}
                  loading="lazy"
                  width={640}
                  height={400}
                  class="h-full w-full object-cover object-center"
                />
              </div>
            ))}
          </div>
          <div class="mt-2 flex items-center justify-between font-mono text-[10px] text-on-surface-variant">
            <span id="swissPreviewCaption">{profile.corePrinciples[0].previewCaption}</span>
            <span class="text-on-surface">RAW</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Coluna 8/12: Lista de Filetes 1px (divide-y) com Foco Contextual (opacity: 0.25) -->
    <div class="lg:col-span-8 min-w-0">
      <div
        id="swissFocusList"
        class="swiss-focus-list divide-y divide-outline-variant border-y border-outline-variant stage-glass-panel px-6"
      >
        {profile.corePrinciples.map((item, idx) => (
          <article
            data-swiss-row={idx}
            data-caption={item.previewCaption}
            tabindex="0"
            class="swiss-focus-row group py-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 cursor-default focus-visible:outline-none"
          >
            <div class="flex items-baseline gap-4 min-w-0">
              <span class="font-mono text-xs text-on-surface-variant group-hover:text-on-surface">
                {item.index}
              </span>
              <div>
                <h2 class="text-lg sm:text-xl font-bold text-on-surface tracking-tight">
                  {item.title}
                </h2>
                <p class="font-mono text-xs text-on-surface-variant mt-0.5">
                  {item.subtitle}
                </p>
              </div>
            </div>

            <code class="font-mono text-[11px] text-on-surface border border-outline-variant group-hover:border-outline bg-surface-container-lowest px-3 py-1 rounded-none shrink-0">
              {item.spec}
            </code>
          </article>
        ))}
      </div>

      <div class="mt-8 flex justify-end">
        <a href={withBase('/projetos')} class="editorial-link">
          <span>03 VER PROJETOS</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</SiteLayout>

<script is:inline>
  (() => {
    const list = document.getElementById('swissFocusList');
    const previewContainer = document.getElementById('swissPreviewContainer');
    const captionEl = document.getElementById('swissPreviewCaption');
    if (!list || !previewContainer) return;

    const rows = list.querySelectorAll('[data-swiss-row]');
    const slides = previewContainer.querySelectorAll('[data-swiss-preview-slide]');

    const activateSlide = (idx, caption) => {
      previewContainer.classList.remove('opacity-0', 'translate-y-2');
      previewContainer.classList.add('opacity-100', 'translate-y-0');
      slides.forEach((slide) => {
        const isCurrent = slide.getAttribute('data-swiss-preview-slide') === String(idx);
        slide.classList.toggle('opacity-100', isCurrent);
        slide.classList.toggle('opacity-0', !isCurrent);
      });
      if (captionEl && caption) captionEl.textContent = caption;
    };

    const deactivatePreview = () => {
      previewContainer.classList.add('opacity-0', 'translate-y-2');
      previewContainer.classList.remove('opacity-100', 'translate-y-0');
    };

    rows.forEach((row) => {
      const idx = row.getAttribute('data-swiss-row');
      const caption = row.getAttribute('data-caption');
      row.addEventListener('mouseenter', () => activateSlide(idx, caption));
      row.addEventListener('focus', () => activateSlide(idx, caption));
    });

    list.addEventListener('mouseleave', deactivatePreview);
  })();
</script>
