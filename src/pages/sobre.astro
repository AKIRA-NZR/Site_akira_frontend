---
import SiteLayout from '../layouts/SiteLayout.astro';
import { profile } from '../shared/config/profile';
import ToolIcon from '../shared/ui/ToolIcon.astro';
---

<SiteLayout title="AKIRA // SOBRE" stage="902085" currentPage="sobre">
  <div class="space-y-8 sm:space-y-10 min-w-0 max-w-5xl">
    <!-- Cabeçalho com Texto de Apresentação -->
    <header data-motion-item class="space-y-3.5 min-w-0">
      <h1 class="headline-serif">
        <span class="headline-serif-primary">{profile.about.title}</span>
      </h1>

      <p class="font-mono text-xs sm:text-sm text-on-surface-variant leading-relaxed max-w-2xl text-pretty">
        {profile.about.description}
      </p>
    </header>

    <!-- Grade com os Ícones Oficiais das Ferramentas -->
    <section data-motion-item class="space-y-3 pt-4 border-t border-outline-variant/40 min-w-0">
      <p class="font-mono text-[10px] sm:text-[11px] text-on-surface-variant tracking-[0.16em] sm:tracking-[0.2em]">
        FERRAMENTAS & AMBIENTE DE TRABALHO
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2.5 sm:gap-3 pt-1">
        {profile.tools.map((tool) => (
          <div data-motion-item class="refined-card p-3 sm:p-3.5 flex items-center gap-2.5 sm:gap-3 group min-w-0">
            <div class="text-on-surface-variant group-hover:text-on-surface transition-colors shrink-0">
              <ToolIcon name={tool.icon} class="h-4 w-4 sm:h-4.5 sm:w-4.5" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="font-mono text-[11px] sm:text-xs font-semibold text-on-surface tracking-wider leading-tight">
                {tool.name}
              </div>
              <div class="font-mono text-[9px] text-on-surface-variant tracking-wider opacity-75 mt-0.5 leading-tight">
                {tool.category}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Pilares de Foco (4/12 + 8/12 como estava, com quadro reservado vazio) -->
    <section data-motion-item class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start pt-4 border-t border-outline-variant/40 min-w-0">
      <div class="hidden lg:block lg:col-span-4 min-w-0">
        <div
          id="swissPreviewContainer"
          aria-hidden="true"
          class="transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
        >
          <div class="rounded-none border border-outline-variant bg-surface-container-lowest p-2">
            <div class="relative aspect-[16/10] w-full overflow-hidden rounded-none bg-background/40 border border-dashed border-outline-variant/40 flex items-center justify-center">
              <span class="font-mono text-[10px] text-on-surface-variant/40 tracking-[0.2em]">
                ESPAÇO RESERVADO
              </span>
            </div>
            <div class="mt-2 flex items-center justify-between gap-2 font-mono text-[10px] text-on-surface-variant">
              <span id="swissPreviewCaption" class="min-w-0">{profile.corePrinciples[0].previewCaption}</span>
              <span class="text-on-surface font-semibold shrink-0">ARQUITETURA</span>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-8 min-w-0">
        <div
          id="swissFocusList"
          class="swiss-focus-list divide-y divide-outline-variant/50 border-y border-outline-variant/50"
        >
          {profile.corePrinciples.map((item, idx) => (
            <article
              data-swiss-row={idx}
              data-caption={item.previewCaption}
              tabindex="0"
              class="swiss-focus-row group py-4 sm:py-5 flex items-center justify-between gap-4 cursor-default focus-visible:outline-none min-w-0"
            >
              <div class="min-w-0">
                <h2 class="font-display text-sm sm:text-base font-bold text-on-surface group-hover:text-accent-stage transition-colors tracking-[0.1em] sm:tracking-[0.14em]">
                  {item.title}
                </h2>
                <p class="font-mono text-[10px] sm:text-[11px] text-on-surface-variant mt-0.5">
                  {item.subtitle}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</SiteLayout>

<script is:inline>
  (() => {
    const list = document.getElementById('swissFocusList');
    const captionEl = document.getElementById('swissPreviewCaption');
    if (!list) return;

    const rows = list.querySelectorAll('[data-swiss-row]');

    rows.forEach((row) => {
      const caption = row.getAttribute('data-caption');
      const updateCaption = () => {
        if (captionEl && caption) captionEl.textContent = caption;
      };
      row.addEventListener('mouseenter', updateCaption);
      row.addEventListener('focus', updateCaption);
    });
  })();
</script>
