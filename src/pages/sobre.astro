---
import SiteLayout from '../layouts/SiteLayout.astro';
import { profile } from '../shared/config/profile';
import ToolIcon from '../shared/ui/ToolIcon.astro';
---

<SiteLayout title="AKIRA // SOBRE" stage="902085" currentPage="sobre">
  <div class="space-y-8 sm:space-y-10 min-w-0 max-w-5xl">
    <!-- Cabeçalho com Texto Natural de Apresentação -->
    <header class="space-y-3.5 min-w-0">
      <h1 class="headline-serif">
        <span class="headline-serif-primary">{profile.about.title}</span>
      </h1>

      <p class="font-mono text-xs sm:text-sm text-on-surface-variant leading-relaxed max-w-2xl break-words">
        {profile.about.description}
      </p>
    </header>

    <!-- Grade com os Ícones Oficiais das Ferramentas (astro-icon) -->
    <section class="space-y-3 pt-4 border-t border-outline-variant/40 min-w-0">
      <p class="font-mono text-[10px] sm:text-[11px] text-on-surface-variant tracking-[0.16em] sm:tracking-[0.2em]">
        FERRAMENTAS & AMBIENTE DE TRABALHO
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2.5 sm:gap-3 pt-1">
        {profile.tools.map((tool) => (
          <div class="refined-card p-3 sm:p-3.5 flex items-center gap-2.5 sm:gap-3 group min-w-0">
            <div class="text-on-surface-variant group-hover:text-on-surface transition-colors shrink-0">
              <ToolIcon name={tool.icon} class="h-4 w-4 sm:h-4.5 sm:w-4.5" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="font-mono text-[11px] sm:text-xs font-semibold text-on-surface tracking-wider break-words leading-tight">
                {tool.name}
              </div>
              <div class="font-mono text-[9px] text-on-surface-variant tracking-wider break-words opacity-75 mt-0.5 leading-tight">
                {tool.category}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Pilares de Foco com Print Nativo de Código em Alta Definição (Substituindo as Imagens) -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start pt-4 border-t border-outline-variant/40 min-w-0">
      <div class="hidden lg:block lg:col-span-5 min-w-0">
        <div
          id="swissPreviewContainer"
          aria-hidden="true"
          class="transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
        >
          <!-- Janela de Código / IDE em Vidro Escuro Real (Sem Perda de Qualidade de Imagem) -->
          <div class="rounded-lg border border-outline-variant/70 bg-[#07080c]/90 backdrop-blur-xl shadow-2xl overflow-hidden">
            <!-- Barra de Topo da IDE -->
            <div class="flex items-center justify-between px-3.5 py-2.5 border-b border-white/10 bg-white/[0.03]">
              <div class="flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-[#e11d48]/80"></span>
                <span class="h-2 w-2 rounded-full bg-white/25"></span>
                <span class="h-2 w-2 rounded-full bg-white/25"></span>
              </div>
              <span
                id="swissCodeFileName"
                class="font-mono text-[10px] text-white/80 tracking-widest font-semibold"
              >
                {profile.corePrinciples[0].codeFileName}
              </span>
            </div>

            <!-- Corpo do Código Vetorial Nítido -->
            <div class="relative min-h-[205px] p-4 font-mono text-[10px] leading-relaxed text-white/90">
              {profile.corePrinciples.map((item, idx) => (
                <div
                  data-swiss-preview-slide={idx}
                  class:list={[
                    'transition-opacity duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] space-y-1',
                    idx === 0 ? 'opacity-100 relative' : 'opacity-0 absolute inset-4 pointer-events-none',
                  ]}
                >
                  {item.codeLines.map((line, lineIdx) => (
                    <div class="flex items-start gap-3">
                      <span class="text-white/30 select-none w-4 text-right shrink-0">{lineIdx + 1}</span>
                      <code class="text-white/90 break-all whitespace-pre-wrap">{line}</code>
                    </div>
                  ))}
                </div>
              ))}
            </div>

            <!-- Rodapé da Janela de Código -->
            <div class="px-3.5 py-2 border-t border-white/10 bg-white/[0.02] flex items-center justify-between gap-2 font-mono text-[9px] text-white/60">
              <span id="swissPreviewCaption" class="min-w-0 break-words">{profile.corePrinciples[0].previewCaption}</span>
              <span class="text-[#e11d48] font-semibold shrink-0">UTF-8 // LF</span>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 min-w-0">
        <div
          id="swissFocusList"
          class="swiss-focus-list divide-y divide-outline-variant/50 border-y border-outline-variant/50"
        >
          {profile.corePrinciples.map((item, idx) => (
            <article
              data-swiss-row={idx}
              data-caption={item.previewCaption}
              data-filename={item.codeFileName}
              tabindex="0"
              class="swiss-focus-row group py-4 sm:py-5 flex items-center justify-between gap-4 cursor-default focus-visible:outline-none min-w-0"
            >
              <div class="min-w-0">
                <h2 class="font-display text-sm sm:text-base font-bold text-on-surface group-hover:text-accent-stage transition-colors tracking-[0.1em] sm:tracking-[0.14em] break-words">
                  {item.title}
                </h2>
                <p class="font-mono text-[10px] sm:text-[11px] text-on-surface-variant mt-0.5 break-words">
                  {item.subtitle}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</SiteLayout>

<script is:inline>
  (() => {
    const list = document.getElementById('swissFocusList');
    const previewContainer = document.getElementById('swissPreviewContainer');
    const captionEl = document.getElementById('swissPreviewCaption');
    const fileNameEl = document.getElementById('swissCodeFileName');
    if (!list || !previewContainer) return;

    const rows = list.querySelectorAll('[data-swiss-row]');
    const slides = previewContainer.querySelectorAll('[data-swiss-preview-slide]');

    const activateSlide = (idx, caption, filename) => {
      slides.forEach((slide) => {
        const isCurrent = slide.getAttribute('data-swiss-preview-slide') === String(idx);
        slide.classList.toggle('opacity-100', isCurrent);
        slide.classList.toggle('relative', isCurrent);
        slide.classList.toggle('opacity-0', !isCurrent);
        slide.classList.toggle('absolute', !isCurrent);
        slide.classList.toggle('inset-4', !isCurrent);
        slide.classList.toggle('pointer-events-none', !isCurrent);
      });
      if (captionEl && caption) captionEl.textContent = caption;
      if (fileNameEl && filename) fileNameEl.textContent = filename;
    };

    rows.forEach((row) => {
      const idx = row.getAttribute('data-swiss-row');
      const caption = row.getAttribute('data-caption');
      const filename = row.getAttribute('data-filename');
      row.addEventListener('mouseenter', () => activateSlide(idx, caption, filename));
      row.addEventListener('focus', () => activateSlide(idx, caption, filename));
    });
  })();
</script>
