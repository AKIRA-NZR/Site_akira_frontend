---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import ToolIcon from '../shared/ui/ToolIcon.astro';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<SiteLayout title="AKIRA // PROJETOS" stage="1396090" currentPage="projetos">
  <div class="space-y-6 sm:space-y-10 min-w-0">
    <!-- Cabeçalho Limpo Responsivo -->
    <header>
      <h1 class="headline-serif">
        <span class="headline-serif-primary">PROJETOS.</span>
      </h1>
    </header>

    <!-- Cards com Maior Transparência, Badges em Vermelho Kaneda + Ícones e Terminal Preto Real -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 lg:gap-8 min-w-0">
      {projects.map((project) => {
        const { data } = project;
        return (
          <article class="refined-card p-5 sm:p-7 lg:p-8 flex flex-col justify-between gap-5 sm:gap-6 min-w-0 shadow-lg">
            <div class="space-y-3.5 sm:space-y-4 min-w-0">
              <!-- Topo do Card -->
              <div class="flex items-center justify-between gap-3 font-mono text-xs min-w-0">
                <span class="px-2 py-0.5 border border-[#b91c1c]/40 bg-[#b91c1c]/10 text-[#991b1b] font-semibold tracking-wider uppercase text-[10px] sm:text-[11px] break-words">
                  {data.type}
                </span>
                <div class="flex items-center gap-3 shrink-0">
                  {data.liveUrl && (
                    <a
                      href={data.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="editorial-link text-[11px]"
                    >
                      <span>DEMO</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                  {data.githubUrl && (
                    <a
                      href={data.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="editorial-link text-[11px]"
                    >
                      <span>GITHUB</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </div>

              <!-- Título do Projeto Responsivo -->
              <h2 class="font-display text-base sm:text-xl lg:text-2xl font-bold text-on-surface tracking-[0.1em] sm:tracking-[0.14em] break-words">
                {data.title}
              </h2>

              <!-- Resumo -->
              <p class="font-mono text-xs text-on-surface/85 leading-relaxed break-words font-medium">
                {data.summary}
              </p>

              <!-- Tecnologias com Ícones Oficiais e Destaque em Vermelho Akira -->
              <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-1">
                {data.technologies.map((tech) => (
                  <span class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1 text-[10px] sm:text-[11px] font-mono font-semibold border border-[#b91c1c]/45 bg-[#b91c1c]/12 text-[#7f1d1d] hover:bg-[#b91c1c] hover:text-white transition-colors tracking-wider rounded-sm">
                    {tech.icon && (
                      <ToolIcon name={tech.icon} class="h-3.5 w-3.5 shrink-0" />
                    )}
                    <span>{tech.name}</span>
                  </span>
                ))}
              </div>
            </div>

            <!-- Terminal Preto Estilo Terminal de Verdade -->
            {data.cliCommand && (
              <div class="pt-2 min-w-0">
                <div class="rounded-md overflow-hidden border border-black/80 bg-[#090a0f] text-[#f0efe9] shadow-md min-w-0">
                  <!-- Barra de Topo do Terminal -->
                  <div class="flex items-center justify-between px-3 py-1.5 border-b border-white/10 bg-white/[0.04]">
                    <div class="flex items-center gap-1.5">
                      <span class="h-2 w-2 rounded-full bg-[#e11d48]"></span>
                      <span class="h-2 w-2 rounded-full bg-white/25"></span>
                      <span class="h-2 w-2 rounded-full bg-white/25"></span>
                    </div>
                    <span class="font-mono text-[9px] text-white/50 tracking-widest">BASH // TERMINAL</span>
                  </div>

                  <!-- Linha de Comando -->
                  <div class="flex items-start gap-2.5 px-3.5 py-2.5 font-mono text-[11px] sm:text-xs min-w-0">
                    <span class="text-[#e11d48] font-bold select-none shrink-0">❯</span>
                    <code class="text-[#f0efe9] break-all sm:break-words min-w-0 leading-relaxed">{data.cliCommand}</code>
                  </div>
                </div>
              </div>
            )}
          </article>
        );
      })}
    </section>
  </div>
</SiteLayout>
