---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<SiteLayout title="AKIRA // PROJETOS" stage="1396090" currentPage="projetos">
  <div class="space-y-10">
    <!-- Cabeçalho Limpo Sem Kicker e Sem Link Redundante de Contato -->
    <header>
      <h1 class="headline-serif text-3xl sm:text-5xl">
        <span class="headline-serif-primary">PROJETOS.</span>
      </h1>
    </header>

    <!-- Cards Refatorados (Sem Métricas de Desempenho, Terminal Refatorado, Tecnologias Limpas) -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      {projects.map((project) => {
        const { data } = project;
        return (
          <article class="refined-card p-6 sm:p-8 flex flex-col justify-between gap-6">
            <div class="space-y-4">
              <!-- Topo do Card -->
              <div class="flex items-center justify-between gap-3 font-mono text-xs">
                <span class="text-on-surface-variant tracking-wider uppercase text-[11px]">{data.type}</span>
                {data.githubUrl && (
                  <a
                    href={data.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="editorial-link text-[11px]"
                  >
                    <span>GITHUB</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>

              <!-- Título do Projeto -->
              <h2 class="font-display text-lg sm:text-2xl font-bold text-on-surface tracking-[0.14em]">
                {data.title}
              </h2>

              <!-- Resumo -->
              <p class="font-mono text-xs text-on-surface-variant leading-relaxed">
                {data.summary}
              </p>

              <!-- Tecnologias em Chips Refatorados -->
              <div class="flex flex-wrap gap-2 pt-1">
                {data.technologies.map((tech) => (
                  <span class="px-3 py-1 text-[11px] font-mono border border-outline-variant/60 bg-surface-container-lowest text-on-surface tracking-wider">
                    {tech.name}
                  </span>
                ))}
              </div>
            </div>

            <!-- Terminal Refatorado e Elegante -->
            {data.cliCommand && (
              <div class="pt-3 border-t border-outline-variant/40">
                <div class="flex items-center gap-2 px-3.5 py-2.5 bg-surface-container-lowest border border-outline-variant/60 font-mono text-xs text-on-surface">
                  <span class="text-on-surface-variant opacity-50 select-none">❯</span>
                  <code class="truncate">{data.cliCommand}</code>
                </div>
              </div>
            )}
          </article>
        );
      })}
    </section>
  </div>
</SiteLayout>
