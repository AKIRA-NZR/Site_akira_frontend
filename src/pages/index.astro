---
import SiteLayout from '../layouts/SiteLayout.astro';
import { profile } from '../shared/config/profile';
import { withBase } from '../shared/routing/paths';
---

<SiteLayout title="AKIRA // ENGENHARIA DE SOFTWARE" stage="video" currentPage="inicio">
  <!-- Apresentação Pessoal no Canto Superior Esquerdo (Estilo Japonês Editorial) -->
  <section data-motion-item class="w-full max-w-xs sm:max-w-sm lg:max-w-md space-y-2.5 sm:space-y-4 min-w-0">
    <!-- Tag Kicker com Katakana Autêntico -->
    <div class="flex items-center gap-2">
      <span class="inline-block w-1.5 h-1.5 bg-on-surface rounded-full opacity-60"></span>
      <span class="font-mono text-[9px] sm:text-[10px] text-on-surface-variant tracking-[0.24em]">
        アキラ // ENGENHARIA BACK-END
      </span>
    </div>

    <!-- Título Monumental Shippori Mincho (Estilo Japonês de Alto Padrão) -->
    <h1 class="headline-serif text-balance">
      <span class="headline-serif-primary block text-xl sm:text-2xl md:text-3xl lg:text-[2.65rem] font-bold tracking-[0.03em] leading-[1.08]">
        ARQUITETURA DE SOFTWARE.
      </span>
      <span class="headline-serif-secondary block text-base sm:text-lg md:text-xl lg:text-[1.95rem] font-medium tracking-[0.03em] leading-[1.14] mt-0.5 sm:mt-1 text-on-surface/75">
        SISTEMAS DISTRIBUÍDOS & BACK-END.
      </span>
    </h1>

    <!-- Bio / Manifesto com Tipografia Japonesa Moderna (Zen Kaku Gothic) -->
    <p class="font-jp-gothic text-[11px] sm:text-xs text-on-surface-variant leading-relaxed max-w-xs sm:max-w-sm text-pretty tracking-wide">
      <span class="sm:hidden">ENGENHARIA DE SISTEMAS, MICROSSERVIÇOS E ARQUITETURA BACK-END DE ALTA PERFORMANCE COM JAVA & SPRING BOOT.</span>
      <span class="hidden sm:inline">{profile.intro.bio}</span>
    </p>

    <!-- Ações Rápidas Adaptadas para Todas as Telas -->
    <div class="flex flex-wrap items-center gap-2.5 sm:gap-4 pt-0.5 sm:pt-1">
      <a
        href={withBase('/projetos')}
        class="inline-flex items-center gap-1.5 px-3.5 sm:px-4 py-2 sm:py-2.5 border border-on-surface bg-on-surface text-background font-mono text-[10px] sm:text-xs font-bold tracking-[0.14em] sm:tracking-[0.16em] transition-all duration-300 hover:bg-transparent hover:text-on-surface group cursor-pointer"
      >
        <span>EXPLORAR PROJETOS</span>
        <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>

      <a
        href={withBase('/sobre')}
        class="editorial-link py-1.5 font-mono text-[10px] sm:text-xs tracking-[0.14em] sm:tracking-[0.16em]"
      >
        <span>SOBRE A TRAJETÓRIA</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Metadados Técnicos em Linha Minimalista -->
    <div class="pt-2.5 sm:pt-3 border-t border-outline-variant/30 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[9px] sm:text-[10px] text-on-surface-variant">
      <div>
        <span class="opacity-60">STACK //</span>
        <span class="text-on-surface font-semibold ml-1">JAVA 21 · SPRING BOOT · DOCKER</span>
      </div>
      <div>
        <span class="opacity-60">STATUS //</span>
        <span class="text-on-surface font-semibold ml-1 inline-flex items-center gap-1.5">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          DISPONÍVEL
        </span>
      </div>
    </div>
  </section>
</SiteLayout>
