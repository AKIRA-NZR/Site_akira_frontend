---
import SiteLayout from "../layouts/SiteLayout.astro";
import Header from "../features/navigation/Header.astro";
import Hero from "../features/hero/Hero.astro";
import About from "../features/about/About.astro";
import Stack from "../features/stack/Stack.astro";
import Projects from "../features/projects/Projects.astro";
import Contact from "../features/contact/Contact.astro";
import Footer from "../features/navigation/Footer.astro";
import { profile } from "../shared/config/profile";
---

<SiteLayout
  title={`${profile.handle} // ${profile.title}`}
  description={`${profile.summary} Especialista em sistemas distribuídos, concorrência e bancos de dados.`}
>
  <Header />
  <main class="flex-grow">
    <Hero />
    <About />
    <Stack />
    <Projects />
    <Contact />
  </main>
  <Footer />
</SiteLayout>
