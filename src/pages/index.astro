---
import SiteLayout from '../layouts/SiteLayout.astro';
import { profile } from '../shared/config/profile';
---

<SiteLayout title="AKIRA" stage="video" currentPage="inicio">
  <!-- Apresentação Pessoal & Boas-Vindas Direta (Sem Frases Genéricas, Sem Poluição) -->
  <section class="max-w-2xl space-y-6">
    <h1 class="headline-serif text-4xl sm:text-6xl lg:text-7xl">
      <span class="headline-serif-primary">{profile.intro.welcome}</span>
    </h1>

    <p class="font-mono text-xs sm:text-sm text-on-surface-variant leading-relaxed max-w-xl">
      {profile.intro.bio}
    </p>
  </section>
</SiteLayout>
