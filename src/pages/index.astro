---
import SiteLayout from '../layouts/SiteLayout.astro';
import { profile } from '../shared/config/profile';
import { withBase } from '../shared/routing/paths';
---

<SiteLayout title="AKIRA" stage="video" currentPage="inicio">
  <!-- Apresentação Pessoal & Boas-Vindas no Canto Esquerdo -->
  <section data-motion-item class="w-full max-w-sm sm:max-w-md lg:max-w-lg space-y-3.5 sm:space-y-4 min-w-0">
    <!-- Título de Boas-Vindas com a Fonte Original (Cinzel) -->
    <h1 class="headline-serif text-balance">
      <span class="headline-serif-primary block text-3xl sm:text-4xl md:text-5xl lg:text-[3.5rem] font-bold tracking-[0.03em] leading-[1.08]">
        {profile.intro.welcome}
      </span>
    </h1>

    <!-- Bio com a Fonte Original (JetBrains Mono) -->
    <p class="font-mono text-xs sm:text-sm text-on-surface-variant leading-relaxed max-w-sm sm:max-w-md text-pretty">
      {profile.intro.bio}
    </p>

    <!-- Apenas o Botão Explorar Projetos -->
    <div class="pt-1.5 sm:pt-2">
      <a
        href={withBase('/projetos')}
        class="inline-flex items-center gap-2 px-4 sm:px-5 py-2.5 sm:py-3 border border-on-surface bg-on-surface text-background font-mono text-[11px] sm:text-xs font-bold tracking-[0.16em] transition-all duration-300 hover:bg-transparent hover:text-on-surface group cursor-pointer"
      >
        <span>EXPLORAR PROJETOS</span>
        <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</SiteLayout>
