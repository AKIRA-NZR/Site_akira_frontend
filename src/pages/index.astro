---
import SiteLayout from '../layouts/SiteLayout.astro';
import { profile } from '../shared/config/profile';
import { withBase } from '../shared/routing/paths';
---

<SiteLayout title="AKIRA" stage="video" currentPage="inicio">
  <!-- Apresentação Pessoal & Boas-Vindas: Centralizado no Mobile, Alinhado à Esquerda no PC -->
  <section
    data-motion-item
    class="w-full max-w-sm sm:max-w-md lg:max-w-lg space-y-4 sm:space-y-5 min-w-0 mx-auto md:mx-0 flex flex-col items-center md:items-start text-center md:text-left"
  >
    <!-- Título de Boas-Vindas com a Fonte Original (Cinzel) -->
    <h1 class="headline-serif text-balance">
      <span class="headline-serif-primary block text-3xl sm:text-4xl md:text-5xl lg:text-[3.5rem] font-bold tracking-[0.03em] leading-[1.08]">
        {profile.intro.welcome}
      </span>
    </h1>

    <!-- Bio com a Fonte Original (JetBrains Mono) -->
    <p class="font-mono text-xs sm:text-sm text-on-surface-variant leading-relaxed max-w-xs sm:max-w-md text-pretty">
      {profile.intro.bio}
    </p>

    <!-- Apenas o Botão Explorar Projetos (Com Contorno Refinado em Vidro / Dark Luxury) -->
    <div class="pt-2 sm:pt-3">
      <a
        href={withBase('/projetos')}
        class="inline-flex items-center gap-2 px-5 py-2.5 sm:py-3 border border-on-surface/80 bg-background/60 backdrop-blur-md text-on-surface font-mono text-[11px] sm:text-xs font-semibold tracking-[0.16em] transition-all duration-300 hover:bg-on-surface hover:text-background group cursor-pointer shadow-lg shadow-black/20"
      >
        <span>EXPLORAR PROJETOS</span>
        <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</SiteLayout>
