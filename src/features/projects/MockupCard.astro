---
import type { CollectionEntry } from 'astro:content';
import { PHOTO_AKIRA_BIKE_SET } from '../../shared/media/frontImages';
import ResponsivePicture from '../../shared/ui/ResponsivePicture.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  elevation?: '1' | '2' | '3' | '4' | '5';
}

const { project, elevation = '3' } = Astro.props;
const { data } = project;
---

<article
  data-elevation={elevation}
  class="spotlight-card flex flex-col justify-between"
>
  <div class="p-6 sm:p-7">
    <div class="flex items-center justify-between gap-4 mb-4">
      <span class="editorial-kicker">FULLSTACK // TELEMETRIA</span>

      <div class="flex items-center gap-4">
        {data.githubUrl && (
          <a
            href={data.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="editorial-link text-xs"
          >
            <span>GitHub</span>
            <span aria-hidden="true">↗</span>
          </a>
        )}
        {data.liveUrl && (
          <a
            href={data.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="editorial-link text-xs"
          >
            <span>Live Demo</span>
            <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>

    <h3 class="text-xl font-semibold text-on-surface tracking-tight mb-2 min-w-0 break-words">
      {data.title}
    </h3>

    <p class="text-sm text-on-surface-variant leading-relaxed mb-5 min-w-0 break-words">
      {data.summary}
    </p>

    <!-- Versões Exatas em Chips Monocromáticos -->
    <div class="flex flex-wrap gap-2 mb-5">
      {data.technologies.map((tech) => (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-mono bg-surface-container-lowest text-on-surface border border-outline-variant">
          <span>{tech.name}</span>
          {tech.version && (
            <span class="text-on-surface-variant">{tech.version}</span>
          )}
        </span>
      ))}
    </div>

    <!-- Métricas de Engenharia em Filetes 1px -->
    {data.metrics && (
      <div class="grid grid-cols-3 divide-x divide-outline-variant border border-outline-variant rounded bg-surface-container-lowest py-2.5 text-center font-mono">
        {data.metrics.throughput && (
          <div class="px-2 min-w-0">
            <div class="text-[10px] text-on-surface-variant uppercase">Vazão</div>
            <div class="text-xs font-semibold text-on-surface">{data.metrics.throughput}</div>
          </div>
        )}
        {data.metrics.latency_p99 && (
          <div class="px-2 min-w-0">
            <div class="text-[10px] text-on-surface-variant uppercase">p99</div>
            <div class="text-xs font-semibold text-on-surface">{data.metrics.latency_p99}</div>
          </div>
        )}
        {data.metrics.uptime && (
          <div class="px-2 min-w-0">
            <div class="text-[10px] text-on-surface-variant uppercase">SLA</div>
            <div class="text-xs font-semibold text-on-surface">{data.metrics.uptime}</div>
          </div>
        )}
      </div>
    )}
  </div>

  <!-- Mockup de Interface com Arte Real e Painel de Telemetria (Polimorfismo Fullstack) -->
  <div class="border-t border-outline-variant bg-surface-container-lowest overflow-hidden">
    <div class="px-4 py-2 border-b border-outline-variant flex items-center justify-between font-mono text-[11px] text-on-surface-variant">
      <span>console.internal // mesh</span>
      <span>HTTP/3</span>
    </div>

    <div class="relative h-36 overflow-hidden">
      <ResponsivePicture
        image={PHOTO_AKIRA_BIKE_SET}
        alt={data.title}
        loading="lazy"
        width={640}
        height={360}
        class="h-full w-full object-cover object-center opacity-45"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-background via-background/60 to-transparent flex items-end p-4">
        <div class="w-full flex items-center justify-between font-mono text-xs text-on-surface border border-outline-variant bg-background/85 backdrop-blur-md px-3 py-2">
          <span>TRACE_STREAM: ACTIVE</span>
          <span class="text-on-surface-variant">60 FPS // 8.5ms</span>
        </div>
      </div>
    </div>
  </div>
</article>
