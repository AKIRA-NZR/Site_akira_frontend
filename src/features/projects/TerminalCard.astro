---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  elevation?: '1' | '2' | '3' | '4' | '5';
}

const { project, elevation = '3' } = Astro.props;
const { data } = project;
---

<article
  data-elevation={elevation}
  class="spotlight-card flex flex-col justify-between"
>
  <div class="p-6 sm:p-7">
    <div class="flex items-center justify-between gap-4 mb-4">
      <span class="editorial-kicker">BACKEND // SISTEMA</span>

      <div class="flex items-center gap-4">
        {data.githubUrl && (
          <a
            href={data.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="editorial-link text-xs"
          >
            <span>GitHub</span>
            <span aria-hidden="true">↗</span>
          </a>
        )}
        {data.liveUrl && (
          <a
            href={data.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="editorial-link text-xs"
          >
            <span>Docs</span>
            <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>

    <h3 class="text-xl font-semibold text-on-surface tracking-tight mb-2 min-w-0 break-words">
      {data.title}
    </h3>

    <p class="text-sm text-on-surface-variant leading-relaxed mb-5 min-w-0 break-words">
      {data.summary}
    </p>

    <!-- Versões Exatas em Chips Monocromáticos -->
    <div class="flex flex-wrap gap-2 mb-5">
      {data.technologies.map((tech) => (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-mono bg-surface-container-lowest text-on-surface border border-outline-variant">
          <span>{tech.name}</span>
          {tech.version && (
            <span class="text-on-surface-variant">{tech.version}</span>
          )}
        </span>
      ))}
    </div>

    <!-- Métricas de Engenharia em Filetes 1px -->
    {data.metrics && (
      <div class="grid grid-cols-3 divide-x divide-outline-variant border border-outline-variant rounded bg-surface-container-lowest py-2.5 text-center font-mono">
        {data.metrics.throughput && (
          <div class="px-2 min-w-0">
            <div class="text-[10px] text-on-surface-variant uppercase">Vazão</div>
            <div class="text-xs font-semibold text-on-surface">{data.metrics.throughput}</div>
          </div>
        )}
        {data.metrics.latency_p99 && (
          <div class="px-2 min-w-0">
            <div class="text-[10px] text-on-surface-variant uppercase">p99</div>
            <div class="text-xs font-semibold text-on-surface">{data.metrics.latency_p99}</div>
          </div>
        )}
        {data.metrics.uptime && (
          <div class="px-2 min-w-0">
            <div class="text-[10px] text-on-surface-variant uppercase">SLA</div>
            <div class="text-xs font-semibold text-on-surface">{data.metrics.uptime}</div>
          </div>
        )}
      </div>
    )}
  </div>

  <!-- Terminal CLI Estilizado Monocromático (Polimorfismo Backend) -->
  <div class="border-t border-outline-variant bg-surface-container-lowest font-mono text-xs">
    <div class="px-4 py-2 border-b border-outline-variant flex items-center justify-between text-[11px] text-on-surface-variant">
      <div class="flex items-center gap-2">
        <span class="inline-block h-2 w-2 rounded-full border border-outline"></span>
        <span class="inline-block h-2 w-2 rounded-full border border-outline"></span>
        <span class="ml-1">bash — 80x24</span>
      </div>
      <span>x86_64-linux</span>
    </div>

    <div class="p-4 space-y-2 overflow-x-auto">
      {data.cliCommand && (
        <div class="flex items-start gap-2 text-on-surface">
          <span class="text-on-surface-variant select-none">$</span>
          <code class="break-all">{data.cliCommand}</code>
        </div>
      )}
      {data.cliOutput && (
        <div class="text-on-surface-variant text-[11px] leading-relaxed pl-3 border-l border-outline break-all">
          {data.cliOutput}
        </div>
      )}
    </div>
  </div>
</article>
