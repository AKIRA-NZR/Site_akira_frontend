---
import { profile } from '../../shared/config/profile';
import { PHOTO_CHROME_SURFER_SET } from '../../shared/media/frontImages';
import ResponsivePicture from '../../shared/ui/ResponsivePicture.astro';
---

<section
  id="inicio"
  data-section-stage="hero"
  class="mx-auto w-full max-w-6xl px-4 pt-28 pb-16 sm:px-8 sm:pt-32 sm:pb-24"
>
  <!-- Arquétipo A: Quadro Fotográfico Split Half-Blur (.split-photo-hero) -->
  <div class="split-photo-hero min-h-[520px] sm:min-h-[580px] lg:min-h-[620px] flex flex-col justify-between p-6 sm:p-10 lg:p-14">
    <!-- Camada 1: Arte Real de Alta Direção de Arte (1401469.png — Pintura Imediata LCP) -->
    <ResponsivePicture
      image={PHOTO_CHROME_SURFER_SET}
      alt="Arte monocromática cromada sobre vácuo estrelado"
      fetchpriority="high"
      loading="eager"
      width={1280}
      height={720}
      class="split-photo-sharp object-cover object-[72%_center]"
    />

    <!-- Camada 2: Lente Óptica Direcional 90° (.split-lens-left) -->
    <div class="split-lens-left" aria-hidden="true"></div>

    <!-- Conteúdo Protegido pela Lente Half-Blur -->
    <div class="relative z-10 my-auto max-w-xl md:max-w-[54%] lg:max-w-[50%] min-w-0">
      <p class="editorial-kicker mb-4">
        {profile.handle} // {profile.specialty}
      </p>

      <h1 class="headline-bicolor text-3xl sm:text-5xl lg:text-[3.35rem] tracking-tight mb-6 min-w-0 break-words">
        <span class="headline-bicolor-primary">Arquitetura de sistemas.</span>
        <span class="headline-bicolor-secondary">Engenharia de baixa latência.</span>
      </h1>

      <p class="text-sm sm:text-base text-on-surface-variant leading-relaxed mb-8 max-w-md min-w-0 break-words">
        {profile.summary}
      </p>

      <!-- Ações 100% Monocromáticas (Inversão Pura + Link Editorial) -->
      <div class="flex flex-wrap items-center gap-6">
        <a
          href="#projetos"
          class="inline-flex items-center justify-center rounded-full border border-on-surface bg-on-surface px-6 py-2.5 text-xs sm:text-sm font-semibold text-background transition-opacity duration-200 hover:opacity-90"
        >
          Explorar Sistemas
        </a>

        <a href="#stack" class="editorial-link group">
          <span>Inspecionar Stack</span>
          <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- Rodapé de Métricas de Precisão em Filetes 1px -->
    <div class="relative z-10 mt-12 pt-6 border-t border-outline-variant grid grid-cols-3 gap-4 sm:gap-8 max-w-lg">
      {profile.metrics.map((metric) => (
        <div class="min-w-0">
          <div class="flex items-baseline gap-1.5 font-mono">
            <span class="text-lg sm:text-2xl font-semibold text-on-surface">{metric.value}</span>
            <span class="text-xs text-on-surface-variant">{metric.unit}</span>
          </div>
          <p class="text-xs text-on-surface-variant mt-0.5 break-words">{metric.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
