---
import { profile } from "../../shared/config/profile";
---

<section id="contato" class="relative py-28 border-b border-[var(--color-border-tech)] overflow-hidden">
  <!-- Fundo Fotográfico Estrelado & Cosmos Profundo -->
  <div class="absolute inset-0 z-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.15),rgba(255,255,255,0))]"></div>
  
  <!-- Campo Estrelado Subtil com Pontos de Luz (Constelação Técnica) -->
  <div class="absolute inset-0 z-0 opacity-40 pointer-events-none" style="background-image: radial-gradient(1px 1px at 20px 30px, #ffffff, rgba(0,0,0,0)), radial-gradient(1px 1px at 75px 80px, #ffffff, rgba(0,0,0,0)), radial-gradient(1.5px 1.5px at 140px 120px, #ea6a2a, rgba(0,0,0,0)), radial-gradient(1px 1px at 220px 160px, #ffffff, rgba(0,0,0,0)), radial-gradient(1px 1px at 310px 240px, #ffffff, rgba(0,0,0,0)), radial-gradient(1.5px 1.5px at 450px 70px, #ffffff, rgba(0,0,0,0)); background-size: 550px 550px;"></div>

  <div class="absolute inset-0 z-10 bg-gradient-to-t from-[var(--color-bg-canvas)] via-[oklch(11%_0.008_260_/_0.85)] to-[var(--color-bg-canvas)]"></div>

  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[oklch(14%_0.008_260)] border border-[var(--color-border-tech)] text-xs font-mono text-[var(--color-accent-signal)] mb-4">
        <span class="w-2 h-2 rounded-full bg-[var(--color-accent-signal)] animate-ping"></span>
        <span>// 04. CANAL DE COMUNICAÇÃO DIRETO</span>
      </div>
      <h2 class="headline-bicolor text-3xl sm:text-5xl font-bold tracking-tight mb-4 items-center">
        <span class="line-primary">Iniciar Conexão</span>
        <span class="line-secondary text-[var(--color-text-secondary)] font-normal">& Canais de Engenharia.</span>
      </h2>
      <p class="text-base text-[var(--color-text-secondary)] max-w-xl mx-auto">
        Aberto a discussões técnicas, projetos de alta escala, consultoria em arquitetura de microsserviços ou oportunidades estratégicas.
      </p>
    </div>

    <!-- Container em Vidro Fumê com Estilo Cosmos Noturno -->
    <div class="max-w-4xl mx-auto rounded-2xl smoked-glass p-8 sm:p-12 relative overflow-hidden">
      <!-- Glow sutil de fundo do card -->
      <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-[var(--color-accent-signal)]/10 blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <!-- Lado Esquerdo: Redes e Formas de Contato -->
        <div class="space-y-4">
          <div class="text-xs font-mono text-[var(--color-text-muted)] uppercase tracking-wider mb-2">
            // ENDPOINTS DISPONÍVEIS
          </div>

          {profile.socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-4 rounded-lg bg-[oklch(11%_0.008_260_/_0.8)] border border-[var(--color-border-tech)] hover:border-[var(--color-accent-signal)]/60 hover:bg-[oklch(14%_0.008_260)] transition-all group"
            >
              <div class="flex items-center gap-3">
                <span class="w-2 h-2 rounded-full bg-[var(--color-accent-signal)] opacity-70 group-hover:opacity-100 transition-opacity"></span>
                <span class="text-sm font-semibold text-[var(--color-text-primary)]">
                  {social.label}
                </span>
              </div>
              <span class="text-xs font-mono text-[var(--color-text-secondary)] group-hover:text-[var(--color-accent-signal)] transition-colors">
                {social.username} ↗
              </span>
            </a>
          ))}
        </div>

        <!-- Lado Direito: Terminal de Handshake & Copiar E-mail -->
        <div class="p-6 rounded-xl bg-[oklch(10%_0.008_260)] border border-[var(--color-border-tech)] font-mono text-xs space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-[var(--color-border-tech)] text-[11px] text-[var(--color-text-muted)]">
            <span>SESSION: SECURE_CHANNEL</span>
            <span class="text-emerald-400">● ENCRYPTED</span>
          </div>

          <div class="space-y-2 text-[var(--color-text-secondary)]">
            <div class="flex justify-between">
              <span class="text-[var(--color-text-muted)]">Protocol:</span>
              <span class="text-[var(--color-text-primary)]">SSH-2.0 / TLS 1.3</span>
            </div>
            <div class="flex justify-between">
              <span class="text-[var(--color-text-muted)]">Recipient:</span>
              <span class="text-[var(--color-text-primary)]">{profile.handle}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-[var(--color-text-muted)]">Response SLA:</span>
              <span class="text-[var(--color-accent-signal)] font-semibold">&lt; 24h</span>
            </div>
          </div>

          <div class="pt-3 border-t border-[var(--color-border-tech)]">
            <div class="text-[11px] text-[var(--color-text-muted)] mb-2">
              Clique abaixo para copiar o endereço direto:
            </div>
            <button
              id="copy-email-btn"
              data-email="akira.eng@proton.me"
              class="w-full py-2.5 px-4 rounded bg-[oklch(16%_0.009_260)] hover:bg-[oklch(20%_0.01_260)] text-[var(--color-text-primary)] border border-[var(--color-border-tech)] hover:border-[var(--color-accent-signal)] transition-all flex items-center justify-center gap-2 cursor-pointer font-bold"
            >
              <span id="copy-email-text">akira.eng@proton.me</span>
              <span id="copy-status" class="text-xs text-[var(--color-accent-signal)]">[copiar]</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById("copy-email-btn");
  const copyStatus = document.getElementById("copy-status");

  if (copyBtn && copyStatus) {
    copyBtn.addEventListener("click", async () => {
      const email = copyBtn.getAttribute("data-email") || "akira.eng@proton.me";
      try {
        await navigator.clipboard.writeText(email);
        copyStatus.textContent = "[copiado com sucesso!]";
        copyStatus.style.color = "#34d399";
        setTimeout(() => {
          copyStatus.textContent = "[copiar]";
          copyStatus.style.color = "var(--color-accent-signal)";
        }, 3000);
      } catch (err) {
        console.error("Falha ao copiar:", err);
      }
    });
  }
</script>
