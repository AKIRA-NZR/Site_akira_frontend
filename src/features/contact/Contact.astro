---
import { profile } from '../../shared/config/profile';
import { PHOTO_STARRY_COSMOS_SET } from '../../shared/media/frontImages';
import ResponsivePicture from '../../shared/ui/ResponsivePicture.astro';
---

<section
  id="contato"
  data-section-stage="contact"
  class="mx-auto w-full max-w-6xl px-4 py-20 sm:px-8 sm:py-28 border-t border-outline-variant"
>
  <!-- Palco Estrelado com Arte 491593.jpg e Quadro Centralizado em Vidro Fumê -->
  <div class="relative rounded-xl border border-outline-variant overflow-hidden min-h-[460px] flex items-center justify-center p-6 sm:p-12 lg:p-16">
    <!-- Fundo Fotográfico: 491593.jpg (Céu Estrelado P&B Minimalista) -->
    <div class="absolute inset-0 pointer-events-none select-none" aria-hidden="true">
      <ResponsivePicture
        image={PHOTO_STARRY_COSMOS_SET}
        alt="Céu estrelado minimalista em preto e branco"
        loading="lazy"
        width={1280}
        height={720}
        class="h-full w-full object-cover object-left-bottom opacity-85"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-background/50 via-background/65 to-background/80"></div>
    </div>

    <!-- Quadro Centralizado em Vidro Fumê Translúcido -->
    <div class="smoked-comparison-surface relative z-10 w-full max-w-2xl rounded-xl p-8 sm:p-12 text-center">
      <p class="editorial-kicker mb-3">04 // Canal Direto</p>

      <h2 class="headline-bicolor text-2xl sm:text-4xl mb-4 min-w-0 break-words">
        <span class="headline-bicolor-primary">Iniciar conexão.</span>
        <span class="headline-bicolor-secondary">Arquitetura e sistemas críticos.</span>
      </h2>

      <p class="text-sm text-on-surface-variant max-w-md mx-auto mb-8 leading-relaxed min-w-0 break-words">
        Disponível para projetos de engenharia back-end, desenho de sistemas distribuídos e consultoria técnica.
      </p>

      <!-- E-mail em Destaque + Botão de Cópia com 1 Clique em Inversão Pura -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-10">
        <div class="w-full sm:w-auto px-5 py-2.5 rounded-full border border-outline-variant bg-background/80 font-mono text-xs sm:text-sm text-on-surface break-all">
          akira.eng@proton.me
        </div>

        <button
          type="button"
          id="copyEmailBtn"
          data-email="akira.eng@proton.me"
          class="w-full sm:w-auto inline-flex items-center justify-center rounded-full border border-on-surface bg-on-surface px-6 py-2.5 text-xs sm:text-sm font-semibold text-background cursor-pointer transition-opacity duration-200 hover:opacity-90"
        >
          <span id="copyEmailLabel">Copiar E-mail</span>
        </button>
      </div>

      <!-- Links Diretos com Sublinhado Editorial Deslocado (underline-offset-8) -->
      <div class="pt-6 border-t border-outline-variant flex flex-wrap items-center justify-center gap-8">
        {profile.socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="editorial-link group"
          >
            <span>{social.label}</span>
            <span class="font-mono text-xs text-on-surface-variant group-hover:text-on-surface transition-colors">
              ({social.username})
            </span>
            <span class="transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const btn = document.getElementById('copyEmailBtn');
    const label = document.getElementById('copyEmailLabel');
    if (!btn || !label) return;

    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email') || 'akira.eng@proton.me';
      try {
        await navigator.clipboard.writeText(email);
        label.textContent = 'E-mail Copiado ✓';
        setTimeout(() => {
          label.textContent = 'Copiar E-mail';
        }, 2600);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  })();
</script>
