---
import { PHOTO_MOEBIUS_TRUSS_SET } from '../../shared/media/frontImages';
import ResponsivePicture from '../../shared/ui/ResponsivePicture.astro';

const stackItems = [
  { name: 'Go', version: 'v1.23', domain: 'Concorrência & Microsserviços' },
  { name: 'Rust', version: 'v1.80', domain: 'Gateways & Baixa Latência' },
  { name: 'Node.js / TS', version: 'v22.4', domain: 'APIs & Contratos Tipados' },
  { name: 'PostgreSQL', version: 'v16.3', domain: 'Armazenamento ACID' },
  { name: 'Redis', version: 'v7.2', domain: 'Cache & Locks Atômicos' },
  { name: 'Apache Kafka', version: 'v3.7', domain: 'Mensageria Particionada' },
  { name: 'ClickHouse', version: 'v24.6', domain: 'Telemetria Colunar OLAP' },
  { name: 'gRPC / Protobuf', version: 'v3.0', domain: 'Comunicação Binária RPC' },
  { name: 'Docker', version: 'v27.0', domain: 'Imagens Distroless' },
  { name: 'Kubernetes', version: 'v1.30', domain: 'Orquestração de Clusters' },
  { name: 'OpenTelemetry', version: 'v1.27', domain: 'Tracing Distribuído' },
  { name: 'Linux / Cloudflare', version: 'Edge', domain: 'Kernel Tuning & Rede' },
] as const;
---

<section
  id="stack"
  data-section-stage="stack"
  class="mx-auto w-full max-w-6xl px-4 py-20 sm:px-8 sm:py-28 border-t border-outline-variant"
>
  <!-- Cabeçalho Ultralimpo com Densidade Executiva -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
    <div class="max-w-xl min-w-0">
      <p class="editorial-kicker mb-3">02 // Stack & Ferramentas</p>
      <h2 class="headline-bicolor text-2xl sm:text-3xl lg:text-4xl min-w-0 break-words">
        <span class="headline-bicolor-primary">Núcleo tecnológico.</span>
        <span class="headline-bicolor-secondary">Versões homologadas em produção.</span>
      </h2>
    </div>

    <p class="text-xs font-mono text-on-surface-variant">
      12 FERRAMENTAS CENTRAIS // ZERO OVERHEAD
    </p>
  </div>

  <!-- Superfície em Vidro Fumê (backdrop-filter: blur(28px)) sobre Arte 607758.jpg -->
  <div class="relative rounded-xl border border-outline-variant overflow-hidden">
    <!-- Textura Fotográfica de Fundo -->
    <div class="absolute inset-0 pointer-events-none select-none" aria-hidden="true">
      <ResponsivePicture
        image={PHOTO_MOEBIUS_TRUSS_SET}
        alt=""
        loading="lazy"
        width={1280}
        height={720}
        class="h-full w-full object-cover object-center opacity-25"
      />
    </div>

    <!-- Camada Interna em Vidro Fumê com Filetes 1px (Sem Comparações, Texto Mínimo) -->
    <div class="smoked-comparison-surface relative z-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-outline-variant">
      {[0, 1, 2, 3].map((colIndex) => {
        const colItems = stackItems.slice(colIndex * 3, colIndex * 3 + 3);
        return (
          <div class="divide-y divide-outline-variant">
            {colItems.map((tech) => (
              <div class="p-6 sm:p-7 flex flex-col justify-between gap-4 hover:bg-background/45 transition-colors duration-200 min-w-0">
                <div class="flex items-center justify-between gap-3">
                  <span class="text-base font-semibold text-on-surface tracking-tight truncate">
                    {tech.name}
                  </span>
                  <span class="font-mono text-[11px] text-on-surface border border-outline-variant bg-background/70 px-2 py-0.5 rounded">
                    {tech.version}
                  </span>
                </div>
                <p class="text-xs text-on-surface-variant font-mono break-words">
                  {tech.domain}
                </p>
              </div>
            ))}
          </div>
        );
      })}
    </div>
  </div>
</section>
