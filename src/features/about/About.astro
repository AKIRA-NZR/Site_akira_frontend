---
import { profile } from '../../shared/config/profile';
import ResponsivePicture from '../../shared/ui/ResponsivePicture.astro';
---

<section
  id="sobre"
  data-section-stage="about"
  class="mx-auto w-full max-w-6xl px-4 py-20 sm:px-8 sm:py-28 border-t border-outline-variant"
>
  <!-- Arquétipo B: Seção Assimétrica Editorial 4/12 + 8/12 -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-12 lg:gap-x-16 items-start relative">
    <!-- Coluna Esquerda Estática (4/12) -->
    <div class="lg:col-span-4 min-w-0">
      <p class="editorial-kicker mb-3">01 // Engenharia & Filosofia</p>

      <h2 class="headline-bicolor text-2xl sm:text-3xl lg:text-4xl mb-5 min-w-0 break-words">
        <span class="headline-bicolor-primary">Precisão estrutural.</span>
        <span class="headline-bicolor-secondary">Sistemas sem ruído.</span>
      </h2>

      <p class="text-sm text-on-surface-variant leading-relaxed mb-8 min-w-0 break-words">
        {profile.bioContext}
      </p>

      <!-- Metadados Operacionais em Filetes 1px -->
      <dl class="divide-y divide-outline-variant border-y border-outline-variant text-xs font-mono">
        <div class="py-3 flex items-center justify-between gap-4">
          <dt class="text-on-surface-variant">ENGENHEIRO</dt>
          <dd class="text-on-surface font-semibold">{profile.handle}</dd>
        </div>
        <div class="py-3 flex items-center justify-between gap-4">
          <dt class="text-on-surface-variant">OPERAÇÃO</dt>
          <dd class="text-on-surface">{profile.location}</dd>
        </div>
        <div class="py-3 flex items-center justify-between gap-4">
          <dt class="text-on-surface-variant">STATUS</dt>
          <dd class="text-on-surface">{profile.status}</dd>
        </div>
      </dl>

      <!-- Container Flutuante Periférico Sem Cantos Arredondados (rounded-none) sobre a Grade Suíça -->
      <div
        id="swissPreviewContainer"
        aria-hidden="true"
        class="hidden lg:block mt-8 pointer-events-none opacity-0 translate-y-2 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
      >
        <div class="rounded-none border border-outline bg-surface-container-lowest p-2 shadow-2xl">
          <div class="relative aspect-[16/10] w-full overflow-hidden rounded-none bg-background">
            {profile.corePrinciples.map((item, idx) => (
              <div
                data-swiss-preview-slide={idx}
                class:list={[
                  'absolute inset-0 transition-opacity duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]',
                  idx === 0 ? 'opacity-100' : 'opacity-0',
                ]}
              >
                <ResponsivePicture
                  image={item.previewImage}
                  alt={item.title}
                  loading="lazy"
                  width={640}
                  height={400}
                  class="h-full w-full object-cover object-center"
                />
              </div>
            ))}
          </div>
          <div class="mt-2 flex items-center justify-between border-t border-outline-variant pt-2 font-mono text-[10px] text-on-surface-variant">
            <span id="swissPreviewCaption">{profile.corePrinciples[0].previewCaption}</span>
            <span class="text-on-surface">1:1 RAW</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Coluna Direita (8/12): Lista de Filetes Técnicos 1px com Seletor de Foco Contextual -->
    <div class="lg:col-span-8 min-w-0">
      <div
        id="swissFocusList"
        class="swiss-focus-list divide-y divide-outline-variant border-y border-outline-variant"
      >
        {profile.corePrinciples.map((item, idx) => (
          <article
            data-swiss-row={idx}
            data-caption={item.previewCaption}
            tabindex="0"
            class="swiss-focus-row group py-7 sm:py-8 cursor-default focus-visible:outline-none"
          >
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-3">
              <div class="flex items-baseline gap-4 min-w-0">
                <span class="font-mono text-xs text-on-surface-variant group-hover:text-on-surface transition-colors">
                  {item.index}
                </span>
                <h3 class="text-lg sm:text-xl font-semibold text-on-surface tracking-tight min-w-0 break-words">
                  {item.title}
                </h3>
              </div>

              <span class="font-mono text-xs text-on-surface-variant group-hover:text-on-surface transition-colors shrink-0">
                {item.subtitle}
              </span>
            </div>

            <div class="sm:pl-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
              <p class="text-sm text-on-surface-variant group-hover:text-on-surface/90 transition-colors max-w-xl leading-relaxed min-w-0 break-words">
                {item.description}
              </p>

              <code class="font-mono text-[11px] text-on-surface-variant group-hover:text-on-surface group-hover:border-outline border border-outline-variant bg-surface-container px-2.5 py-1 rounded-none shrink-0 transition-colors">
                {item.spec}
              </code>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const list = document.getElementById('swissFocusList');
    const previewContainer = document.getElementById('swissPreviewContainer');
    const captionEl = document.getElementById('swissPreviewCaption');
    if (!list || !previewContainer) return;

    const rows = list.querySelectorAll('[data-swiss-row]');
    const slides = previewContainer.querySelectorAll('[data-swiss-preview-slide]');

    const activateSlide = (idx, caption) => {
      previewContainer.classList.remove('opacity-0', 'translate-y-2');
      previewContainer.classList.add('opacity-100', 'translate-y-0');
      slides.forEach((slide) => {
        const isCurrent = slide.getAttribute('data-swiss-preview-slide') === String(idx);
        slide.classList.toggle('opacity-100', isCurrent);
        slide.classList.toggle('opacity-0', !isCurrent);
      });
      if (captionEl && caption) {
        captionEl.textContent = caption;
      }
    };

    const deactivatePreview = () => {
      previewContainer.classList.add('opacity-0', 'translate-y-2');
      previewContainer.classList.remove('opacity-100', 'translate-y-0');
    };

    rows.forEach((row) => {
      const idx = row.getAttribute('data-swiss-row');
      const caption = row.getAttribute('data-caption');
      row.addEventListener('mouseenter', () => activateSlide(idx, caption));
      row.addEventListener('focus', () => activateSlide(idx, caption));
    });

    list.addEventListener('mouseleave', deactivatePreview);
    list.addEventListener('focusout', (e) => {
      if (!list.contains(e.relatedTarget)) {
        deactivatePreview();
      }
    });
  })();
</script>
