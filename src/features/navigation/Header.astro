---
import { profile } from '../../shared/config/profile';
import { withBase } from '../../shared/routing/paths';

const navItems = [
  { label: 'Sobre', href: '#sobre' },
  { label: 'Stack', href: '#stack' },
  { label: 'Projetos', href: '#projetos' },
  { label: 'Contato', href: '#contato' },
] as const;
---

<header
  id="mainNav"
  class="fixed top-5 inset-x-4 sm:inset-x-8 z-50 mx-auto max-w-6xl pointer-events-none"
>
  <div
    id="mainNavBar"
    class="navigation-glass pointer-events-auto flex items-center justify-between gap-4 rounded-full px-5 py-2.5 sm:px-7 will-change-transform"
  >
    <!-- Marca Tipográfica Pura (VOID Blueprint V2 — Sem ícones artificiais) -->
    <a
      href={withBase('/')}
      class="inline-flex items-center font-display text-base sm:text-lg font-semibold tracking-tight text-on-surface focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-on-surface"
    >
      {profile.handle}
    </a>

    <!-- Links Centrais Diretos -->
    <nav aria-label="Navegação principal" class="hidden md:flex items-center gap-8">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-on-surface-variant hover:text-on-surface transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-on-surface"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Ação Monocromática em Inversão Pura + Gatilho Mobile de 2 Traços Paralelos -->
    <div class="flex items-center gap-3">
      <a
        href="#contato"
        class="hidden sm:inline-flex items-center justify-center rounded-full border border-on-surface bg-on-surface px-4 py-1.5 text-xs font-semibold tracking-wide text-background transition-opacity duration-200 hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-on-surface"
      >
        Contato Direto
      </a>

      <!-- Menu Mobile Minimalista: Apenas 2 Traços Horizontais Paralelos -->
      <button
        type="button"
        id="navDrawerToggle"
        aria-label="Abrir navegação"
        aria-expanded="false"
        aria-controls="navDrawerPanel"
        class="inline-flex md:hidden h-8 w-8 items-center justify-center text-on-surface hover:opacity-80 cursor-pointer transition-opacity focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-on-surface"
      >
        <svg
          class="h-5 w-6 text-on-surface"
          viewBox="0 0 24 18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="square"
          aria-hidden="true"
        >
          <line x1="2" y1="5.5" x2="22" y2="5.5" />
          <line x1="2" y1="12.5" x2="22" y2="12.5" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Drawer Mobile em Vidro Fumê -->
  <div
    id="navDrawerPanel"
    hidden
    class="navigation-glass pointer-events-auto mt-2 rounded-2xl p-5 md:hidden"
  >
    <nav aria-label="Navegação mobile" class="flex flex-col divide-y divide-outline-variant">
      {navItems.map((item) => (
        <a
          href={item.href}
          data-mobile-nav-link
          class="py-3 text-sm font-medium text-on-surface-variant hover:text-on-surface transition-colors"
        >
          {item.label}
        </a>
      ))}
      <div class="pt-4">
        <a
          href="#contato"
          data-mobile-nav-link
          class="inline-flex w-full items-center justify-center rounded-full border border-on-surface bg-on-surface px-4 py-2 text-xs font-semibold text-background"
        >
          Contato Direto
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const navBar = document.getElementById('mainNavBar');
    const toggleBtn = document.getElementById('navDrawerToggle');
    const drawerPanel = document.getElementById('navDrawerPanel');
    let lastScrollY = window.scrollY;

    window.addEventListener(
      'scroll',
      () => {
        const currentY = window.scrollY;
        if (!navBar) return;
        if (currentY > lastScrollY && currentY > 96) {
          navBar.classList.add('-translate-y-24', 'opacity-0', 'pointer-events-none');
          if (drawerPanel && !drawerPanel.hidden) {
            drawerPanel.hidden = true;
            toggleBtn?.setAttribute('aria-expanded', 'false');
          }
        } else {
          navBar.classList.remove('-translate-y-24', 'opacity-0', 'pointer-events-none');
        }
        lastScrollY = currentY;
      },
      { passive: true }
    );

    if (toggleBtn && drawerPanel) {
      toggleBtn.addEventListener('click', () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
        drawerPanel.hidden = isExpanded;
      });

      drawerPanel.querySelectorAll('[data-mobile-nav-link]').forEach((link) => {
        link.addEventListener('click', () => {
          drawerPanel.hidden = true;
          toggleBtn.setAttribute('aria-expanded', 'false');
        });
      });
    }
  })();
</script>
