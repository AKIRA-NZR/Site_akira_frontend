---
import { profile } from "../../shared/config/profile";
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[var(--color-border-tech)] bg-[var(--color-bg-canvas)] py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-3">
      <span class="w-2 h-2 rounded-full bg-[var(--color-accent-signal)]"></span>
      <span class="font-['JetBrains_Mono',monospace] font-bold text-sm tracking-wider text-[var(--color-text-primary)]">
        {profile.handle}
      </span>
      <span class="text-xs text-[var(--color-text-muted)] font-mono">
        // {profile.specialty}
      </span>
    </div>

    <div class="flex items-center gap-6 text-xs font-mono text-[var(--color-text-secondary)]">
      {profile.socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[var(--color-accent-signal)] transition-colors"
        >
          {social.label}
        </a>
      ))}
      <a href="#" class="hover:text-[var(--color-text-primary)] transition-colors">
        [ topo ↑ ]
      </a>
    </div>

    <div class="text-xs font-mono text-[var(--color-text-muted)] text-center md:text-right">
      <span>© {currentYear} {profile.handle}. Void Frontend Blueprint V2.</span>
    </div>
  </div>
</footer>
