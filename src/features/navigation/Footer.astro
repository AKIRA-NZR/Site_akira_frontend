---
import { profile } from '../../shared/config/profile';
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-outline-variant bg-surface-container-lowest/90 py-10 px-4 sm:px-8">
  <div class="mx-auto max-w-6xl flex flex-col sm:flex-row items-center justify-between gap-6">
    <!-- Marca Tipográfica Pura (Sem ícones artificiais) -->
    <div class="flex items-baseline gap-3">
      <span class="font-display text-sm font-semibold tracking-tight text-on-surface">
        {profile.handle}
      </span>
      <span class="text-xs font-mono text-on-surface-variant">
        // {profile.specialty}
      </span>
    </div>

    <div class="flex items-center gap-6 text-xs font-mono text-on-surface-variant">
      {profile.socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-on-surface transition-colors"
        >
          {social.label}
        </a>
      ))}
      <a href="#inicio" class="hover:text-on-surface transition-colors">
        Topo ↑
      </a>
    </div>

    <p class="text-xs font-mono text-on-surface-variant">
      © {currentYear} {profile.handle}
    </p>
  </div>
</footer>
