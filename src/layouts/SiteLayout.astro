---
import '../styles/global.css';
import { profile } from '../shared/config/profile';
import {
  PHOTO_CHROME_SURFER_SET,
  PHOTO_HALFTONE_DARK_SET,
  PHOTO_AKIRA_BIKE_SET,
  PHOTO_MOEBIUS_TRUSS_SET,
} from '../shared/media/frontImages';
import CorporateBackdrop from '../shared/effects/CorporateBackdrop.astro';
import { withBase } from '../shared/routing/paths';

interface Props {
  title?: string;
  stage: 'video' | '902085' | '1396090' | '607758';
  currentPage: 'inicio' | 'sobre' | 'projetos' | 'contato';
}

const {
  title = 'AKIRA',
  stage,
  currentPage,
} = Astro.props;

const stageImageMap = {
  video: PHOTO_CHROME_SURFER_SET,
  '902085': PHOTO_HALFTONE_DARK_SET,
  '1396090': PHOTO_AKIRA_BIKE_SET,
  '607758': PHOTO_MOEBIUS_TRUSS_SET,
} as const;

const activeImage = stageImageMap[stage];

// Navegação Limpa Sem Numerações
const pages = [
  { id: 'inicio', label: 'INÍCIO', href: withBase('/') },
  { id: 'sobre', label: 'SOBRE', href: withBase('/sobre') },
  { id: 'projetos', label: 'PROJETOS', href: withBase('/projetos') },
  { id: 'contato', label: 'CONTATO', href: withBase('/contato') },
] as const;

const fontStylesheetUrl =
  'https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,600;6..96,700&family=Cinzel:wght@400;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap';
---

<!doctype html>
<html lang="pt-BR" data-theme-stage={stage}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={stage === '1396090' ? '#d8d8de' : '#07080c'} />
    <meta name="description" content="AKIRA // DESENVOLVEDOR BACK-END" />
    <meta name="author" content={profile.handle} />

    <title>{title}</title>

    <!-- Preload Seletivo da Arte em AVIF -->
    <link
      rel="preload"
      as="image"
      href={activeImage.mobileAvif}
      type="image/avif"
      media="(max-width: 767px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={activeImage.avif}
      type="image/avif"
      media="(min-width: 768px)"
      fetchpriority="high"
    />

    <!-- Fontes da Referência (Cinzel + Bodoni Moda + Plus Jakarta Sans + JetBrains Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href={fontStylesheetUrl}
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href={fontStylesheetUrl} />
    </noscript>

    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%2307080c'/><text x='50' y='68' font-family='serif' font-size='56' font-weight='700' fill='%23f0efe9' text-anchor='middle'>A</text></svg>"
    />
  </head>
  <body class="min-h-dvh flex flex-col justify-between antialiased selection:bg-on-surface selection:text-background relative">
    <!-- Átrio em Tela Cheia com Alta Visibilidade -->
    <CorporateBackdrop stage={stage} />

    <!-- Topo Editorial de Canto a Canto (Mais Próximo das Bordas e Bem Espaçado) -->
    <header class="relative z-10 w-full max-w-[1680px] mx-auto px-6 pt-6 sm:px-10 sm:pt-9 lg:px-14 flex items-center justify-between gap-6 shrink-0">
      <!-- Marca Discreta no Canto Superior Esquerdo -->
      <a
        href={withBase('/')}
        class="brand-signature shrink-0"
      >
        AKIRA
      </a>

      <!-- Menu Minimalista no Canto Superior Direito com Alta Visibilidade -->
      <nav
        aria-label="PÁGINAS"
        class="flex items-center gap-5 sm:gap-8 lg:gap-11 font-display text-[10px] sm:text-xs"
      >
        {pages.map((p) => {
          const isActive = p.id === currentPage;
          return (
            <a
              href={p.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'nav-link tracking-[0.16em] sm:tracking-[0.24em] border-b',
                isActive
                  ? 'text-on-surface border-outline font-bold'
                  : 'text-on-surface/80 border-transparent hover:text-on-surface hover:border-outline-variant',
              ]}
            >
              {p.label}
            </a>
          );
        })}
      </nav>
    </header>

    <!-- Conteúdo Central com Espaçamento Refinado e Ancoragem por Contexto -->
    <main
      class:list={[
        'relative z-10 w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-14 flex-grow flex flex-col min-w-0',
        currentPage === 'inicio'
          ? 'justify-start items-start pt-8 sm:pt-12 lg:pt-14 pb-12'
          : currentPage === 'contato'
            ? 'justify-center items-start py-14 sm:py-20'
            : 'justify-start pt-10 sm:pt-14 lg:pt-16 pb-16 sm:pb-24',
      ]}
    >
      <slot />
    </main>

    <!-- Rodapé Minimalista com Alta Visibilidade -->
    <footer class="relative z-10 w-full max-w-[1680px] mx-auto px-6 pb-7 sm:px-10 sm:pb-9 lg:px-14 border-t border-outline-variant/35 pt-5 shrink-0">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 font-mono text-[10px] sm:text-[11px] text-on-surface-variant">
        <!-- Identificação Pura -->
        <div class="flex items-center gap-3">
          <span class="font-display text-xs font-bold text-on-surface tracking-[0.2em]">AKIRA</span>
        </div>

        <!-- Links Sociais Diretos com Alta Visibilidade -->
        <div class="flex flex-wrap items-center gap-6 tracking-widest text-on-surface font-semibold">
          {profile.socials.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="py-1 hover:text-accent-stage transition-colors"
            >
              <span>{s.label}</span>
              <span class="opacity-80" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </footer>
  </body>
</html>
