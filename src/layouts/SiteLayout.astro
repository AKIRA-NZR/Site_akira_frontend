---
import '../styles/global.css';
import { profile } from '../shared/config/profile';
import {
  PHOTO_CHROME_SURFER_SET,
  PHOTO_HALFTONE_DARK_SET,
  PHOTO_AKIRA_BIKE_SET,
  PHOTO_MOEBIUS_TRUSS_SET,
  VIDEO_FEATURED_STAGE,
} from '../shared/media/frontImages';
import ResponsivePicture from '../shared/ui/ResponsivePicture.astro';
import { withBase } from '../shared/routing/paths';

interface Props {
  title?: string;
  stage: 'video' | '902085' | '1396090' | '607758';
  currentPage: 'inicio' | 'sobre' | 'projetos' | 'contato';
}

const {
  title = 'AKIRA',
  stage,
  currentPage,
} = Astro.props;

const stageImageMap = {
  video: PHOTO_CHROME_SURFER_SET,
  '902085': PHOTO_HALFTONE_DARK_SET,
  '1396090': PHOTO_AKIRA_BIKE_SET,
  '607758': PHOTO_MOEBIUS_TRUSS_SET,
} as const;

const activeImage = stageImageMap[stage];

const pages = [
  { id: 'inicio', code: '01', label: 'INÍCIO', href: withBase('/') },
  { id: 'sobre', code: '02', label: 'SOBRE', href: withBase('/sobre') },
  { id: 'projetos', code: '03', label: 'PROJETOS', href: withBase('/projetos') },
  { id: 'contato', code: '04', label: 'CONTATO', href: withBase('/contato') },
] as const;

const fontStylesheetUrl =
  'https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700&family=Syne:wght@700;800&display=swap';
---

<!doctype html>
<html lang="pt-BR" data-theme-stage={stage}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={stage === '1396090' ? '#d8d8de' : '#07080c'} />
    <meta name="description" content="AKIRA // ARQUITETURA & BACK-END" />
    <meta name="author" content={profile.handle} />

    <title>{title}</title>

    <!-- Preload Seletivo da Arte da Página Atual em AVIF -->
    <link
      rel="preload"
      as="image"
      href={activeImage.mobileAvif}
      type="image/avif"
      media="(max-width: 767px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={activeImage.avif}
      type="image/avif"
      media="(min-width: 768px)"
      fetchpriority="high"
    />

    <!-- Fontes Designer (Syne 800 + JetBrains Mono + Plus Jakarta Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href={fontStylesheetUrl}
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href={fontStylesheetUrl} />
    </noscript>

    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%2307080c'/><text x='50' y='68' font-family='sans-serif' font-size='56' font-weight='800' fill='%23f0efe9' text-anchor='middle'>A</text></svg>"
    />
  </head>
  <body class="min-h-screen flex flex-col justify-between antialiased selection:bg-on-surface selection:text-background relative">
    <!-- Background Fullscreen Dinâmico da Página Atual -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden select-none" aria-hidden="true">
      {stage === 'video' ? (
        <>
          <ResponsivePicture
            image={PHOTO_CHROME_SURFER_SET}
            alt=""
            fetchpriority="high"
            loading="eager"
            width={1280}
            height={720}
            class="h-full w-full object-cover object-center"
          />
          <video
            autoplay
            muted
            loop
            playsinline
            poster={PHOTO_CHROME_SURFER_SET.avif}
            class="absolute inset-0 h-full w-full object-cover object-center"
          >
            <source src={VIDEO_FEATURED_STAGE} type="video/mp4" />
          </video>
        </>
      ) : (
        <ResponsivePicture
          image={activeImage}
          alt=""
          fetchpriority="high"
          loading="eager"
          width={1280}
          height={720}
          class:list={[
            'h-full w-full object-cover',
            stage === '1396090' ? 'object-center opacity-90' : 'object-center opacity-85',
          ]}
        />
      )}

      <!-- Scrim Óptico Calibrado para o Tema da Imagem -->
      <div class="absolute inset-0" style="background: var(--stage-scrim);"></div>
    </div>

    <!-- Topo Editorial Sem Navbar (Apenas Assinatura Designer AKIRA + Índice de Páginas) -->
    <div class="mx-auto w-full max-w-6xl px-5 pt-8 sm:px-10 sm:pt-12 flex flex-col sm:flex-row sm:items-baseline justify-between gap-6">
      <a
        href={withBase('/')}
        class="brand-signature text-3xl sm:text-5xl text-on-surface tracking-tighter"
      >
        AKIRA
      </a>

      <!-- Índice Minimalista entre as 4 Páginas (Sem Navbar Box, Sem Contato Direto) -->
      <nav aria-label="PÁGINAS" class="flex flex-wrap items-center gap-6 sm:gap-8 font-mono text-xs">
        {pages.map((p) => {
          const isActive = p.id === currentPage;
          return (
            <a
              href={p.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'transition-colors duration-200 pb-1 border-b',
                isActive
                  ? 'text-on-surface border-outline font-semibold'
                  : 'text-on-surface-variant border-transparent hover:text-on-surface hover:border-outline-variant',
              ]}
            >
              <span class="opacity-60 mr-1">{p.code}</span>
              <span>{p.label}</span>
            </a>
          );
        })}
      </nav>
    </div>

    <!-- Conteúdo da Página -->
    <main class="mx-auto w-full max-w-6xl px-5 py-10 sm:px-10 sm:py-14 flex-grow flex flex-col justify-center">
      <slot />
    </main>

    <!-- Rodapé Ultramínimo Padronizado em Maiúsculo -->
    <footer class="mx-auto w-full max-w-6xl px-5 pb-8 sm:px-10 sm:pb-10 flex items-center justify-between gap-4 border-t border-outline-variant pt-5 font-mono text-[11px] text-on-surface-variant">
      <span>AKIRA // ARQUITETURA DE SISTEMAS</span>
      <span>STAGE // {stage.toUpperCase()}</span>
    </footer>
  </body>
</html>
