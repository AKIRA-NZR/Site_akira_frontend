---
import '../styles/global.css';
import { profile } from '../shared/config/profile';
import {
  PHOTO_CHROME_SURFER_SET,
  PHOTO_HALFTONE_DARK_SET,
  PHOTO_AKIRA_BIKE_SET,
  PHOTO_MOEBIUS_TRUSS_SET,
} from '../shared/media/frontImages';
import CorporateBackdrop from '../shared/effects/CorporateBackdrop.astro';
import { withBase } from '../shared/routing/paths';

interface Props {
  title?: string;
  stage: 'video' | '902085' | '1396090' | '607758';
  currentPage: 'inicio' | 'sobre' | 'projetos' | 'contato';
}

const {
  title = 'AKIRA',
  stage,
  currentPage,
} = Astro.props;

const stageImageMap = {
  video: PHOTO_CHROME_SURFER_SET,
  '902085': PHOTO_HALFTONE_DARK_SET,
  '1396090': PHOTO_AKIRA_BIKE_SET,
  '607758': PHOTO_MOEBIUS_TRUSS_SET,
} as const;

const activeImage = stageImageMap[stage];

// Navegação Limpa Sem Numerações
const pages = [
  { id: 'inicio', label: 'INÍCIO', href: withBase('/') },
  { id: 'sobre', label: 'SOBRE', href: withBase('/sobre') },
  { id: 'projetos', label: 'PROJETOS', href: withBase('/projetos') },
  { id: 'contato', label: 'CONTATO', href: withBase('/contato') },
] as const;

const fontStylesheetUrl =
  'https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap';
---

<!doctype html>
<html lang="pt-BR" data-theme-stage={stage} data-sw-url={withBase('/sw.js')}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={stage === '1396090' ? '#d8d8de' : '#07080c'} />
    <meta name="description" content="AKIRA // DESENVOLVEDOR BACK-END" />
    <meta name="author" content={profile.handle} />

    <title>{title}</title>

    <!-- Preload Seletivo da Arte/Vídeo com Alta Prioridade -->
    {stage === 'video' ? (
      <>
        <link
          rel="preload"
          as="video"
          href={withBase('/videos/1405430.mp4')}
          type="video/mp4"
        />
        <link
          rel="preload"
          as="image"
          href={activeImage.avif}
          type="image/avif"
          fetchpriority="high"
        />
      </>
    ) : (
      <>
        <link
          rel="preload"
          as="image"
          href={activeImage.mobileAvif}
          type="image/avif"
          media="(max-width: 767px)"
          fetchpriority="high"
        />
        <link
          rel="preload"
          as="image"
          href={activeImage.avif}
          type="image/avif"
          media="(min-width: 768px)"
          fetchpriority="high"
        />
      </>
    )}

    <!-- Fontes da Referência (Carregamento Síncrono Seguro para Eliminar FOUT e Saltos) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontStylesheetUrl} />

    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%2307080c'/><text x='50' y='68' font-family='serif' font-size='56' font-weight='700' fill='%23f0efe9' text-anchor='middle'>A</text></svg>"
    />
  </head>
  <body class="min-h-screen flex flex-col justify-between antialiased selection:bg-on-surface selection:text-background relative">
    <!-- Átrio em Tela Cheia com Alta Visibilidade -->
    <CorporateBackdrop stage={stage} />

    <!-- Topo Editorial de Canto a Canto (Equilíbrio e Escala Refinada) -->
    <header class="relative z-30 w-full max-w-7xl mx-auto px-4 pt-5 sm:px-12 sm:pt-10 lg:px-16 flex items-center justify-between gap-4 sm:gap-6 shrink-0">
      <!-- Marca Discreta no Canto Superior Esquerdo -->
      <a
        href={withBase('/')}
        class="brand-signature shrink-0"
      >
        AKIRA
      </a>

      <!-- Menu Minimalista Desktop (Telas Médias e Grandes >= sm) -->
      <nav
        aria-label="PÁGINAS PRINCIPAIS"
        class="hidden sm:flex items-center gap-6 md:gap-8 lg:gap-10 font-display text-[11px] sm:text-xs"
      >
        {pages.map((p) => {
          const isActive = p.id === currentPage;
          return (
            <a
              href={p.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'nav-link whitespace-nowrap tracking-[0.16em] sm:tracking-[0.24em] border-b',
                isActive
                  ? 'text-on-surface border-outline font-bold'
                  : 'text-on-surface/80 border-transparent hover:text-on-surface hover:border-outline-variant',
              ]}
            >
              {p.label}
            </a>
          );
        })}
      </nav>

      <!-- Botão Menu Mobile Editorial (Apenas 2 Barrinhas Conforme Imagem de Referência — Sem Card e Sem Texto) -->
      <button
        type="button"
        id="mobileMenuToggle"
        aria-expanded="false"
        aria-controls="mobileMenuDrawer"
        aria-label="MENU DE NAVEGAÇÃO"
        class="sm:hidden flex flex-col justify-center items-end gap-1.5 p-2 bg-transparent border-0 cursor-pointer group focus-visible:outline-none"
      >
        <span class="block w-6 h-[1.5px] bg-on-surface transition-all duration-300 group-hover:opacity-75"></span>
        <span class="block w-6 h-[1.5px] bg-on-surface transition-all duration-300 group-hover:opacity-75"></span>
      </button>
    </header>

    <!-- Overlay e Drawer do Menu Mobile (Cyber-Editorial Glass) -->
    <div
      id="mobileMenuDrawer"
      role="dialog"
      aria-modal="true"
      aria-label="MENU DE NAVEGAÇÃO"
      class="fixed inset-0 z-50 sm:hidden flex flex-col justify-between p-6 bg-background/95 backdrop-blur-2xl transition-all duration-300 opacity-0 pointer-events-none -translate-y-2"
    >
      <!-- Topo do Menu Mobile -->
      <div class="flex items-center justify-between border-b border-outline-variant/40 pb-5">
        <a href={withBase('/')} class="brand-signature text-base font-extrabold tracking-[0.24em]">
          AKIRA
        </a>
        <button
          type="button"
          id="mobileMenuClose"
          aria-label="FECHAR MENU"
          class="p-2 bg-transparent border-0 text-on-surface hover:text-accent-stage transition-colors cursor-pointer text-xl leading-none flex items-center justify-center focus-visible:outline-none"
        >
          <span aria-hidden="true">✕</span>
        </button>
      </div>

      <!-- Links Principais com Tipografia Editorial Ampla e Alta Visibilidade (Sem 'ATIVO') -->
      <nav class="flex flex-col gap-5 py-6 my-auto" aria-label="NAVEGAÇÃO MOBILE">
        {pages.map((p) => {
          const isActive = p.id === currentPage;
          return (
            <a
              href={p.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'mobile-nav-link font-display text-2xl font-bold tracking-[0.16em] transition-all py-2.5 border-b flex items-center justify-between',
                isActive
                  ? 'text-on-surface border-outline pl-2 font-black'
                  : 'text-on-surface/50 border-outline-variant/20 hover:text-on-surface hover:pl-2',
              ]}
            >
              <span>{p.label}</span>
            </a>
          );
        })}
      </nav>

      <!-- Rodapé do Menu Mobile: Redes Sociais e Contato Direto -->
      <div class="pt-5 border-t border-outline-variant/40 space-y-3.5">
        <span class="font-mono text-[9px] text-on-surface-variant tracking-[0.2em] block">
          CONECTAR // REDES SOCIAIS
        </span>
        <div class="grid grid-cols-2 gap-3 font-mono text-[11px] text-on-surface font-semibold tracking-wider">
          {profile.socials.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="py-1.5 flex items-center justify-between border-b border-outline-variant/20 hover:text-accent-stage transition-colors"
            >
              <span>{s.label}</span>
              <span class="opacity-70" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Conteúdo Central: Estabilidade Vertical Absoluta (Sem Saltos Entre Páginas) -->
    <main
      class:list={[
        'relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-12 lg:px-16 flex-grow flex flex-col min-w-0',
        currentPage === 'inicio' || currentPage === 'contato'
          ? 'justify-center items-start py-8 sm:py-12'
          : 'justify-start pt-6 sm:pt-12 lg:pt-14 pb-12 sm:pb-14',
      ]}
    >
      <slot />
    </main>

    <!-- Rodapé Minimalista com Alta Visibilidade -->
    <footer class="relative z-10 w-full max-w-7xl mx-auto px-4 pb-6 sm:px-12 sm:pb-10 lg:px-16 border-t border-outline-variant/40 pt-4 sm:pt-5 shrink-0">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 font-mono text-[10px] sm:text-[11px] text-on-surface-variant">
        <!-- Identificação Pura + Cargo -->
        <div class="flex items-center justify-between w-full sm:w-auto gap-4">
          <span class="font-display text-xs font-bold text-on-surface tracking-[0.2em]">AKIRA</span>
          <span class="sm:hidden font-mono text-[9px] text-on-surface-variant tracking-[0.16em]">
            BACK-END & ARQUITETURA
          </span>
        </div>

        <!-- Links Sociais Diretos: Grid 2x2 Simétrico no Mobile e Linha Flex no Desktop -->
        <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-center gap-x-6 gap-y-2.5 sm:gap-6 tracking-widest text-on-surface font-semibold w-full sm:w-auto">
          {profile.socials.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="py-1 whitespace-nowrap hover:text-accent-stage transition-colors flex items-center gap-1.5"
            >
              <span>{s.label}</span>
              <span class="opacity-80" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </footer>

    <!-- Motor Global de Interatividade Leve e Estável (Zero-Lag e Sem Saltos de Layout) -->
    <script>
      // 0. Dispara o feixe de luz no título AKIRA ao entrar em qualquer página
      const brandEl = document.querySelector<HTMLElement>('.brand-signature');
      if (brandEl) {
        requestAnimationFrame(() => {
          setTimeout(() => {
            brandEl.classList.add('is-sheen-ready');
          }, 80);
        });
      }

      // 1. Spotlight Óptico Condicional (Apenas em telas com ponteiro fino/mouse para evitar lag no mobile)
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const cards = document.querySelectorAll<HTMLElement>('.refined-card');
        cards.forEach((card) => {
          card.addEventListener('pointermove', (e: PointerEvent) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            card.style.setProperty('--spot-x', `${x}px`);
            card.style.setProperty('--spot-y', `${y}px`);
          });
        });
      }

      // 3. Controle Acessível do Menu Mobile (Drawer Cyber-Editorial)
      const menuToggle = document.getElementById('mobileMenuToggle');
      const menuClose = document.getElementById('mobileMenuClose');
      const menuDrawer = document.getElementById('mobileMenuDrawer');
      const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

      function openMobileMenu() {
        if (!menuDrawer || !menuToggle) return;
        menuDrawer.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-2');
        menuDrawer.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        menuToggle.setAttribute('aria-expanded', 'true');
        document.body.classList.add('overflow-hidden');
      }

      function closeMobileMenu() {
        if (!menuDrawer || !menuToggle) return;
        menuDrawer.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        menuDrawer.classList.add('opacity-0', 'pointer-events-none', '-translate-y-2');
        menuToggle.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
      }

      if (menuToggle && menuClose && menuDrawer) {
        menuToggle.addEventListener('click', () => {
          const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
          if (isOpen) {
            closeMobileMenu();
          } else {
            openMobileMenu();
          }
        });

        menuClose.addEventListener('click', closeMobileMenu);

        mobileNavLinks.forEach((link) => {
          link.addEventListener('click', closeMobileMenu);
        });

        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menuToggle.getAttribute('aria-expanded') === 'true') {
            closeMobileMenu();
          }
        });
      }

      // 4. Registro do Service Worker para Cache Imutável e Navegação Instantânea Offline
      if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
        window.addEventListener('load', () => {
          const swUrl = document.documentElement.getAttribute('data-sw-url') || './sw.js';
          navigator.serviceWorker.register(swUrl).catch(() => {});
        });
      }
    </script>
  </body>
</html>
