---
interface Props {
  mode?: 'sobre' | 'projetos';
}

const { mode = 'sobre' } = Astro.props;
---

<div
  class="xterm-shell-wrapper rounded-lg border border-outline-variant/60 bg-[#07080c]/92 backdrop-blur-xl shadow-2xl overflow-hidden min-w-0"
  data-terminal-mode={mode}
>
  <!-- Topo Limpo do Terminal (Sem Bolinhas) -->
  <div class="flex items-center justify-between px-4 py-2.5 border-b border-white/10 bg-white/[0.03] font-mono text-[10px]">
    <div class="flex items-center gap-2 text-white/80 tracking-[0.18em] font-semibold">
      <span class="text-[#e11d48]">❯_</span>
      <span>AKIRA@ARCH-ENGINE:~</span>
    </div>
    <div class="flex items-center gap-3">
      <span class="text-white/45 tracking-widest hidden sm:inline">DIGITE "HELP"</span>
      <button
        type="button"
        data-terminal-clear
        class="px-2 py-0.5 border border-white/15 text-white/70 hover:text-white hover:border-white/40 transition-colors cursor-pointer tracking-widest text-[9px]"
      >
        LIMPAR
      </button>
    </div>
  </div>

  <!-- Atalhos Rápidos Clicáveis -->
  <div class="flex flex-wrap items-center gap-1.5 px-3.5 py-2 border-b border-white/10 bg-white/[0.015] font-mono text-[9px]">
    <span class="text-white/40 tracking-wider mr-1">COMANDOS:</span>
    <button type="button" data-term-cmd="help" class="px-2 py-0.5 bg-white/5 hover:bg-[#e11d48]/30 border border-white/10 text-white/80 transition-colors cursor-pointer">HELP</button>
    <button type="button" data-term-cmd="whoami" class="px-2 py-0.5 bg-white/5 hover:bg-[#e11d48]/30 border border-white/10 text-white/80 transition-colors cursor-pointer">WHOAMI</button>
    <button type="button" data-term-cmd="stack" class="px-2 py-0.5 bg-white/5 hover:bg-[#e11d48]/30 border border-white/10 text-white/80 transition-colors cursor-pointer">STACK</button>
    <button type="button" data-term-cmd="projects" class="px-2 py-0.5 bg-white/5 hover:bg-[#e11d48]/30 border border-white/10 text-white/80 transition-colors cursor-pointer">PROJECTS</button>
    <button type="button" data-term-cmd="run void-backend" class="px-2 py-0.5 bg-white/5 hover:bg-[#e11d48]/30 border border-white/10 text-white/80 transition-colors cursor-pointer">RUN VOID-BACKEND</button>
  </div>

  <!-- Container Real do Xterm.js -->
  <div
    class="xterm-mount-node w-full h-[250px] sm:h-[270px] p-2.5 text-left"
     style="text-transform: none;"
  ></div>
</div>

<script>
  import { Terminal } from '@xterm/xterm';
  import { FitAddon } from '@xterm/addon-fit';
  import '@xterm/xterm/css/xterm.css';

  const wrappers = document.querySelectorAll<HTMLElement>('.xterm-shell-wrapper');

  wrappers.forEach((wrapper) => {
    const mountNode = wrapper.querySelector<HTMLElement>('.xterm-mount-node');
    if (!mountNode || mountNode.dataset.initialized === 'true') return;
    mountNode.dataset.initialized = 'true';

    const mode = wrapper.dataset.terminalMode || 'sobre';

    const term = new Terminal({
      cursorBlink: true,
      cursorStyle: 'block',
      fontFamily: '"JetBrains Mono", ui-monospace, SFMono-Regular, monospace',
      fontSize: 12,
      lineHeight: 1.35,
      convertEol: true,
      theme: {
        background: '#07080c',
        foreground: '#f0efe9',
        cursor: '#e11d48',
        cursorAccent: '#07080c',
        selectionBackground: 'rgba(225, 29, 72, 0.35)',
        red: '#e11d48',
        green: '#10b981',
        yellow: '#f59e0b',
        blue: '#38bdf8',
        cyan: '#22d3ee',
        white: '#f0efe9',
        brightBlack: '#64748b',
      },
    });

    const fitAddon = new FitAddon();
    term.loadAddon(fitAddon);
    term.open(mountNode);
    fitAddon.fit();

    const resizeObserver = new ResizeObserver(() => {
      try {
        fitAddon.fit();
      } catch {
        // ignore resize errors when hidden
      }
    });
    resizeObserver.observe(mountNode);

    const PROMPT = '\x1b[1;31m❯\x1b[0m \x1b[1;37makira@arch\x1b[0m:\x1b[36m~\x1b[0m$ ';
    let currentInput = '';
    const history: string[] = [];
    let historyIdx = -1;

    const writePrompt = () => {
      term.write('\r\n' + PROMPT);
    };

    const runCommand = (rawCmd: string, echoCmd = false) => {
      const cmd = rawCmd.trim().toLowerCase();
      if (echoCmd) {
        // Limpa linha atual e escreve comando
        term.write('\r\x1b[K' + PROMPT + rawCmd + '\r\n');
      }

      if (!cmd) {
        term.write(PROMPT);
        return;
      }

      history.unshift(rawCmd);
      historyIdx = -1;

      if (cmd === 'clear' || cmd === 'cls') {
        term.clear();
        term.write(PROMPT);
        return;
      }

      if (cmd === 'help') {
        term.writeln('\x1b[1;31mCOMANDOS DISPONÍVEIS (XTERM.JS REAL):\x1b[0m');
        term.writeln('  \x1b[36mwhoami\x1b[0m            -> PERFIL & ARQUITETURA');
        term.writeln('  \x1b[36mstack\x1b[0m             -> FERRAMENTAS & TECNOLOGIAS');
        term.writeln('  \x1b[36mprojects\x1b[0m          -> LISTAR PROJETOS EM PRODUÇÃO');
        term.writeln('  \x1b[36mrun void-backend\x1b[0m  -> INICIAR CLUSTER MULTI-TENANT SPRING BOOT');
        term.writeln('  \x1b[36mrun periphelion\x1b[0m   -> BUILD & PREVIEW DO ERP ASTRO/OKLCH');
        term.writeln('  \x1b[36mrun opsflow\x1b[0m       -> SUBIR CENTRAL B2B REACT 19 + SLA');
        term.writeln('  \x1b[36mrun docx-engine\x1b[0m   -> EXECUTAR MOTOR PYTHON DOCX/PDF');
        term.writeln('  \x1b[36mcontact\x1b[0m           -> EXIBIR CANAIS DIRETOS');
        term.writeln('  \x1b[36mclear\x1b[0m             -> LIMPAR TERMINAL');
        term.write(PROMPT);
        return;
      }

      if (cmd === 'whoami' || cmd === 'about') {
        term.writeln('\x1b[1;37mAKIRA // DEYVID ALVES\x1b[0m');
        term.writeln('DESENVOLVEDOR BACK-END & ARQUITETURA DE SOFTWARE.');
        term.writeln('FOCO EM JAVA 21, SPRING BOOT, ISOLAMENTO MULTI-TENANT,');
        term.writeln('MODELAGEM POSTGRESQL ACID E AMBIENTES DOCKER REPRODUTÍVEIS.');
        term.write(PROMPT);
        return;
      }

      if (cmd === 'stack' || cmd === 'tools') {
        term.writeln('\x1b[1;31m[STACK & FERRAMENTAS]\x1b[0m');
        term.writeln('  • BACK-END   : JAVA 21, SPRING BOOT, GRADLE, FLYWAY');
        term.writeln('  • DATABASE   : POSTGRESQL 16 (TRANSAÇÕES ACID & MULTI-TENANT)');
        term.writeln('  • DEVOPS     : DOCKER, DOCKER COMPOSE, GIT');
        term.writeln('  • FRONT-END  : ASTRO, REACT 19, TYPESCRIPT, TAILWIND');
        term.writeln('  • WORKFLOW   : NOTION, OBSIDIAN, SLACK');
        term.write(PROMPT);
        return;
      }

      if (cmd === 'projects' || cmd === 'ls') {
        term.writeln('\x1b[1;31m[REPOSITÓRIOS & PROJETOS]\x1b[0m');
        term.writeln('  1. \x1b[1;37mVOID-MAINBACKEND\x1b[0m   (JAVA 21 / SPRING BOOT MULTI-TENANT)');
        term.writeln('  2. \x1b[1;37mPERIPHELION\x1b[0m        (ASTRO / REACT 19 / OKLCH ERP)');
        term.writeln('  3. \x1b[1;37mOPSFLOW FRONTEND\x1b[0m   (REACT 19 / TYPESCRIPT / SLA B2B)');
        term.writeln('  4. \x1b[1;37mDOCX-ENGINE-STUDIO\x1b[0m (PYTHON / AUTOMAÇÃO DOCX & PDF)');
        term.write(PROMPT);
        return;
      }

      if (cmd === 'contact') {
        term.writeln('\x1b[1;31m[CANAIS DE CONTATO]\x1b[0m');
        term.writeln('  • EMAIL     : DKAUA0955@GMAIL.COM');
        term.writeln('  • GITHUB    : HTTPS://GITHUB.COM/AKIRA-NZR');
        term.writeln('  • LINKEDIN  : HTTPS://WWW.LINKEDIN.COM/IN/DEYVID-ALVES-774A94246/');
        term.writeln('  • INSTAGRAM : @AKIR4_NZR');
        term.write(PROMPT);
        return;
      }

      if (cmd === 'pillar 0') {
        term.writeln('\x1b[1;31m[PILAR: ARQUITETURA DE BACK-END]\x1b[0m');
        term.writeln('  • ISOLAMENTO DE TENANT POR CONTEXTO & SESSÃO SEGURA + CSRF');
        term.writeln('  • CONTROLE DE ACESSO BASEADO EM PAPÉIS (RBAC) & AUDITORIA');
        term.writeln('  \x1b[32m✓ STATUS: ARQUITETURA MODULAR SPRING BOOT ATIVA\x1b[0m');
        term.write(PROMPT);
        return;
      }

      if (cmd === 'pillar 1') {
        term.writeln('\x1b[1;31m[PILAR: PERSISTÊNCIA & MODELAGEM]\x1b[0m');
        term.writeln('  • POSTGRESQL 16 COM MIGRAÇÕES VERSIONADAS VIA FLYWAY');
        term.writeln('  • INTEGRIDADE TRANSACIONAL ACID NO CONTROLE DE ESTOQUE E VENDAS');
        term.writeln('  \x1b[32m✓ STATUS: 0 DRIFT DE SCHEMA DETECTADO\x1b[0m');
        term.write(PROMPT);
        return;
      }

      if (cmd === 'pillar 2') {
        term.writeln('\x1b[1;31m[PILAR: CONTÊINERES & AUTOMAÇÃO]\x1b[0m');
        term.writeln('  • ORQUESTRAÇÃO LOCAL E PRODUÇÃO VIA DOCKER COMPOSE');
        term.writeln('  • BUILDS E TESTES AUTOMATIZADOS COM GRADLE WRAPPER');
        term.writeln('  \x1b[32m✓ STATUS: CONTAINERS HEALTHY (PORT 5433 / 8080)\x1b[0m');
        term.write(PROMPT);
        return;
      }

      if (cmd === 'pillar 3') {
        term.writeln('\x1b[1;31m[PILAR: ORGANIZAÇÃO & FLUXO]\x1b[0m');
        term.writeln('  • DOCUMENTAÇÃO TÉCNICA E ARQUITETURA EM OBSIDIAN & NOTION');
        term.writeln('  • FLUXO GIT ESTRUTURADO COM COMMITS SEMÂNTICOS E CODE REVIEW');
        term.writeln('  \x1b[32m✓ STATUS: WORKFLOW SINCRONIZADO\x1b[0m');
        term.write(PROMPT);
        return;
      }

      if (cmd.includes('void-backend') || cmd.includes('gradlew')) {
        term.writeln('\x1b[90m> TASK :COMPILEJAVA UP-TO-DATE\x1b[0m');
        term.writeln('\x1b[32m  .   ____          _            __ _ _\x1b[0m');
        term.writeln('\x1b[32m /\\\\ / ___|_ __ _ _(_)_ __  __ _ \\ \\ \\ \\\x1b[0m');
        term.writeln('\x1b[32m( ( )\\___ | \'_ | \'_| | \'_ \\/ _` | \\ \\ \\ \\\x1b[0m');
        term.writeln('\x1b[36m :: SPRING BOOT ::               (V3.4.0 // JAVA 21)\x1b[0m');
        term.writeln('\x1b[90m[INFO] FLYWAY: VALIDATED 12 MIGRATIONS (SCHEMA: PUBLIC)\x1b[0m');
        term.writeln('\x1b[90m[INFO] MULTI-TENANT CONTEXT FILTER & CSRF PROTECTION INITIALIZED\x1b[0m');
        term.writeln('\x1b[1;32m✓ TOMCAT STARTED ON PORT 8080 (HTTP) — PROFILE: DEV\x1b[0m');
        term.write(PROMPT);
        return;
      }

      if (cmd.includes('periphelion') || cmd.includes('npm run build')) {
        term.writeln('\x1b[36m[ASTRO] BUILDING STATIC ENTRYPOINTS (OKLCH DESIGN SYSTEM)...\x1b[0m');
        term.writeln('\x1b[90m  ├─ /INDEX.HTML (+12MS) — ZERO-JS WATERFALL\x1b[0m');
        term.writeln('\x1b[1;32m✓ PERIPHELION ERP READY AT HTTP://LOCALHOST:4321/\x1b[0m');
        term.write(PROMPT);
        return;
      }

      if (cmd.includes('opsflow') || cmd.includes('npm run dev')) {
        term.writeln('\x1b[36mVITE V6.2.0 READY IN 184 MS\x1b[0m');
        term.writeln('\x1b[90m  ➜ LOCAL:   HTTP://LOCALHOST:5173/ (REACT 19 + TAILWIND V4)\x1b[0m');
        term.writeln('\x1b[1;32m✓ OPSFLOW B2B MULTI-TENANT SLA CONTROL CENTER ACTIVE\x1b[0m');
        term.write(PROMPT);
        return;
      }

      if (cmd.includes('docx') || cmd.includes('python')) {
        term.writeln('\x1b[36m[DOCX-ENGINE-STUDIO] INITIALIZING PYTHON 3.12 RUNTIME...\x1b[0m');
        term.writeln('\x1b[90m  • TEMPLATE PARSER & PDF BATCH AUDITOR LOADED\x1b[0m');
        term.writeln('\x1b[1;32m✓ DESKTOP UI INITIALIZED — 0 ERRORS\x1b[0m');
        term.write(PROMPT);
        return;
      }

      term.writeln(`\x1b[31mCOMANDO NÃO RECONHECIDO:\x1b[0m "${rawCmd}". DIGITE \x1b[36mhelp\x1b[0m PARA VER AS OPÇÕES.`);
      term.write(PROMPT);
    };

    // Mensagem inicial do terminal
    term.writeln('\x1b[1;37mAKIRA INTERACTIVE SHELL // XTERM.JS ENGINE\x1b[0m');
    if (mode === 'projetos') {
      term.writeln('\x1b[90mCLIQUE EM "TESTAR NO TERMINAL" EM QUALQUER PROJETO OU DIGITE \x1b[36mhelp\x1b[90m.\x1b[0m');
    } else {
      term.writeln('\x1b[90mPASSE O MOUSE NOS PILARES AO LADO OU DIGITE \x1b[36mhelp\x1b[90m / \x1b[36mstack\x1b[90m.\x1b[0m');
    }
    term.write(PROMPT);

    // Captura de teclado real no Xterm.js
    term.onData((data) => {
      const code = data.charCodeAt(0);
      if (data === '\r') {
        // Enter
        term.write('\r\n');
        const toRun = currentInput;
        currentInput = '';
        runCommand(toRun, false);
      } else if (code === 127 || data === '\b') {
        // Backspace
        if (currentInput.length > 0) {
          currentInput = currentInput.slice(0, -1);
          term.write('\b \b');
        }
      } else if (code === 3) {
        // Ctrl+C
        currentInput = '';
        term.write('^C');
        writePrompt();
      } else if (code === 12) {
        // Ctrl+L
        currentInput = '';
        term.clear();
        term.write(PROMPT);
      } else if (data === '\x1b[A') {
        // Seta para cima (histórico)
        if (history.length > 0 && historyIdx < history.length - 1) {
          historyIdx++;
          currentInput = history[historyIdx];
          term.write('\r\x1b[K' + PROMPT + currentInput);
        }
      } else if (data === '\x1b[B') {
        // Seta para baixo (histórico)
        if (historyIdx > 0) {
          historyIdx--;
          currentInput = history[historyIdx];
          term.write('\r\x1b[K' + PROMPT + currentInput);
        } else if (historyIdx === 0) {
          historyIdx = -1;
          currentInput = '';
          term.write('\r\x1b[K' + PROMPT);
        }
      } else if (code >= 32 && code <= 126) {
        currentInput += data;
        term.write(data);
      }
    });

    // Botão Limpar
    const clearBtn = wrapper.querySelector('[data-terminal-clear]');
    clearBtn?.addEventListener('click', () => {
      currentInput = '';
      term.clear();
      term.write(PROMPT);
      term.focus();
    });

    // Botões de atalho rápido
    wrapper.querySelectorAll<HTMLElement>('[data-term-cmd]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cmd = btn.getAttribute('data-term-cmd');
        if (cmd) {
          currentInput = '';
          runCommand(cmd, true);
          term.focus();
        }
      });
    });

    // Evento customizado global para permitir que os cards de projetos ou pilares executem comandos neste terminal
    window.addEventListener('akira:terminal-exec', ((e: CustomEvent<{ cmd: string }>) => {
      if (e.detail?.cmd) {
        currentInput = '';
        runCommand(e.detail.cmd, true);
      }
    }) as EventListener);
  });
</script>
