---
import { Icon } from 'astro-icon/components';

interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'h-4 w-4' } = Astro.props;

const iconMap: Record<string, string> = {
  java: 'devicon:java',
  springboot: 'simple-icons:springboot',
  postgresql: 'simple-icons:postgresql',
  docker: 'simple-icons:docker',
  gradle: 'simple-icons:gradle',
  git: 'simple-icons:git',
  astro: 'simple-icons:astro',
  notion: 'simple-icons:notion',
  obsidian: 'simple-icons:obsidian',
  slack: 'simple-icons:slack',
  flyway: 'simple-icons:flyway',
  typescript: 'simple-icons:typescript',
  react: 'simple-icons:react',
  tailwindcss: 'simple-icons:tailwindcss',
  vite: 'simple-icons:vite',
  vitest: 'simple-icons:vitest',
  python: 'simple-icons:python',
  word: 'simple-icons:microsoftword',
  pdf: 'simple-icons:adobeacrobatreader',
  terminal: 'simple-icons:gnubash',
};

const iconKey = name.toLowerCase().replace(/[\s/]/g, '');
const iconName = iconMap[iconKey] || `simple-icons:${iconKey}`;
---

<Icon name={iconName} class={className} aria-hidden="true" />
