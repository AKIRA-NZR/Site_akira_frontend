---
/**
 * CorporateBackdrop V2 — Átrio Desfocado em 3 Camadas Ópticas Dinâmico por Página
 *
 * Camada 1: Difusão Óptica Central (Bokeh — blur(22px) saturate(0.78) contrast(1.06) scale(1.06))
 * Camada 2: Moldura Estrutural Periférica (blur(5px) + máscara elíptica radial)
 * Camada 3: Scrim de Leitura (.atrium-vignette — color-mix dinâmico com --color-background da página)
 */
import {
  PHOTO_CHROME_SURFER_SET,
  PHOTO_HALFTONE_DARK_SET,
  PHOTO_AKIRA_BIKE_SET,
  PHOTO_MOEBIUS_TRUSS_SET,
  VIDEO_FEATURED_STAGE,
} from '../media/frontImages';

interface Props {
  stage: 'video' | '902085' | '1396090' | '607758';
}

const { stage } = Astro.props;

const stageImageMap = {
  video: PHOTO_CHROME_SURFER_SET,
  '902085': PHOTO_HALFTONE_DARK_SET,
  '1396090': PHOTO_AKIRA_BIKE_SET,
  '607758': PHOTO_MOEBIUS_TRUSS_SET,
} as const;

const activeSet = stageImageMap[stage];
---

<div
  id="corporate-backdrop"
  data-atrium-stage={stage}
  class="pointer-events-none fixed inset-0 -z-10 select-none overflow-hidden"
  aria-hidden="true"
>
  <!-- Camada 1: Difusão Óptica Central (Bokeh suave 22px da imagem/vídeo da página) -->
  <div class="atrium-layer-bokeh absolute inset-0 h-full w-full">
    <picture class="contents">
      <source srcset={activeSet.mobileAvif} type="image/avif" />
      <source srcset={activeSet.mobileWebp} type="image/webp" />
      <img
        src={activeSet.src}
        alt=""
        width="768"
        height="432"
        loading="eager"
        fetchpriority="low"
        decoding="async"
        class="atrium-image-bokeh h-full w-full object-cover object-center"
      />
    </picture>
  </div>

  <!-- Camada 2: Moldura Estrutural Periférica (blur 5px + máscara radial elíptica) -->
  <div class="atrium-layer-structural absolute inset-0 h-full w-full">
    {stage === 'video' ? (
      <video
        autoplay
        muted
        loop
        playsinline
        poster={activeSet.mobileAvif}
        class="atrium-image h-full w-full object-cover object-center"
      >
        <source src={VIDEO_FEATURED_STAGE} type="video/mp4" />
      </video>
    ) : (
      <picture class="contents">
        <source srcset={activeSet.mobileAvif} type="image/avif" />
        <source srcset={activeSet.mobileWebp} type="image/webp" />
        <img
          src={activeSet.src}
          alt=""
          width="768"
          height="432"
          loading="eager"
          fetchpriority="low"
          decoding="async"
          class="atrium-image h-full w-full object-cover object-center"
        />
      </picture>
    )}
  </div>

  <!-- Camada 3: Scrim de Leitura Dinâmico (.atrium-vignette calibrado com --color-background) -->
  <div class="atrium-vignette absolute inset-0"></div>
</div>

<style>
  #corporate-backdrop {
    contain: layout paint size;
    opacity: 0.72;
    mix-blend-mode: normal;
  }

  #corporate-backdrop[data-atrium-stage="1396090"] {
    opacity: 0.65;
  }

  .atrium-image-bokeh {
    filter: blur(22px) saturate(0.85) contrast(1.06);
    transform: scale(1.06);
  }

  .atrium-layer-structural {
    mask-image: radial-gradient(
      ellipse 56% 54% at 50% 48%,
      rgba(0, 0, 0, 0.14) 0%,
      rgba(0, 0, 0, 0.54) 58%,
      rgba(0, 0, 0, 0.94) 95%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 56% 54% at 50% 48%,
      rgba(0, 0, 0, 0.14) 0%,
      rgba(0, 0, 0, 0.54) 58%,
      rgba(0, 0, 0, 0.94) 95%
    );
  }

  .atrium-image {
    filter: blur(5px) saturate(0.88) contrast(1.08);
    transform: scale(1.02);
  }

  .atrium-vignette {
    background:
      radial-gradient(
        ellipse 62% 58% at 50% 46%,
        color-mix(in oklch, var(--color-background) 86%, transparent) 0%,
        color-mix(in oklch, var(--color-background) 70%, transparent) 64%,
        color-mix(in oklch, var(--color-background) 44%, transparent) 100%
      ),
      linear-gradient(
        180deg,
        color-mix(in oklch, var(--color-background) 38%, transparent) 0%,
        color-mix(in oklch, var(--color-background) 74%, transparent) 52%,
        color-mix(in oklch, var(--color-background) 92%, transparent) 100%
      );
  }

  @media (forced-colors: active) {
    #corporate-backdrop {
      display: none;
    }
  }
</style>
