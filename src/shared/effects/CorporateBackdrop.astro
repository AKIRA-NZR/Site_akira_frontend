---
/**
 * CorporateBackdrop V2 — Átrio Responsivo em Tela Cheia (Alta Visibilidade com Proteção de Topo)
 *
 * Preenche TODO o background da página (fixed inset-0), garantindo contraste
 * perfeito no cabeçalho e na zona de leitura em qualquer página.
 */
import {
  PHOTO_CHROME_SURFER_SET,
  PHOTO_HALFTONE_DARK_SET,
  PHOTO_AKIRA_BIKE_SET,
  PHOTO_MOEBIUS_TRUSS_SET,
  VIDEO_FEATURED_STAGE,
} from '../media/frontImages';

interface Props {
  stage: 'video' | '902085' | '1396090' | '607758';
}

const { stage } = Astro.props;

const stageImageMap = {
  video: PHOTO_CHROME_SURFER_SET,
  '902085': PHOTO_HALFTONE_DARK_SET,
  '1396090': PHOTO_AKIRA_BIKE_SET,
  '607758': PHOTO_MOEBIUS_TRUSS_SET,
} as const;

const activeSet = stageImageMap[stage];
---

<div
  id="corporate-backdrop"
  data-atrium-stage={stage}
  class="pointer-events-none fixed inset-0 z-0 select-none overflow-hidden"
  aria-hidden="true"
>
  <!-- Camada 1: Arte/Vídeo Nítido em Tela Cheia -->
  <div class="atrium-layer-sharp absolute inset-0 h-full w-full">
    {stage === 'video' ? (
      <video
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline="true"
        x5-playsinline="true"
        preload="auto"
        disablepictureinpicture
        disableremoteplayback
        poster={activeSet.avif}
        class="atrium-media-sharp atrium-video-stage absolute inset-0 h-full w-full object-cover"

      >
        <source src={VIDEO_FEATURED_STAGE} type="video/mp4" />
      </video>
    ) : (
      <picture class="block w-full h-full absolute inset-0">
        <source media="(max-width: 767px)" srcset={activeSet.mobileAvif} type="image/avif" />
        <source media="(max-width: 767px)" srcset={activeSet.mobileWebp} type="image/webp" />
        <source srcset={activeSet.avif} type="image/avif" />
        <source srcset={activeSet.webp} type="image/webp" />
        <img
          src={activeSet.src}
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          class="atrium-media-sharp h-full w-full object-cover object-center"
        />
      </picture>
    )}
  </div>

  <!-- Camada 2: Difusão Óptica Seletiva Responsiva (Apenas Desktop >= 768px para estabilidade absoluta no mobile; desativada em vídeo para evitar dessincronia) -->
  <div class="atrium-layer-soft-focus hidden md:block absolute inset-0 h-full w-full">
    {stage === 'video' ? null : (
      <picture class="block w-full h-full absolute inset-0">
        <source srcset={activeSet.avif} type="image/avif" />
        <source srcset={activeSet.webp} type="image/webp" />
        <img
          src={activeSet.src}
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          class="atrium-media-soft h-full w-full object-cover object-center"
        />
      </picture>
    )}
  </div>

  <!-- Camada 3: Scrim Direcional com Proteção Suave de Topo para o Cabeçalho -->
  <div class="atrium-vignette absolute inset-0"></div>
</div>

<style>
  #corporate-backdrop {
    contain: layout paint;
    opacity: 1;
    mix-blend-mode: normal;
  }

  .atrium-media-sharp,
  .atrium-media-soft {
    filter: blur(0px) saturate(1.04) contrast(1.04);
    transform: none;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .atrium-media-soft {
    filter: blur(7px) saturate(1.02) contrast(1.04);
    transform: none;
  }

  /* Mobile (Desloca o androide para a base, liberando a metade superior para o texto) */
  @media (max-width: 767px) {
    .atrium-video-stage {
      transform: translateY(12%) scale(1.12);
      transform-origin: center bottom;
    }
  }

  /* Tablet (Enquadra o androide no lado direito, liberando o lado esquerdo) */
  @media (min-width: 768px) and (max-width: 1024px) {
    .atrium-video-stage {
      object-position: 25% 50%;
    }
  }

  /* Desktop amplo */
  @media (min-width: 1025px) {
    .atrium-video-stage {
      object-position: 50% 50%;
    }
  }

  /* Mobile */
  @media (max-width: 767px) {
    .atrium-layer-soft-focus {
      mask-image: radial-gradient(
        ellipse 88% 58% at 50% 46%,
        rgba(0, 0, 0, 0.78) 0%,
        rgba(0, 0, 0, 0.3) 64%,
        transparent 94%
      );
      -webkit-mask-image: radial-gradient(
        ellipse 88% 58% at 50% 46%,
        rgba(0, 0, 0, 0.78) 0%,
        rgba(0, 0, 0, 0.3) 64%,
        transparent 94%
      );
    }

    .atrium-vignette {
      background:
        linear-gradient(
          180deg,
          color-mix(in oklch, var(--color-background) 72%, transparent) 0%,
          color-mix(in oklch, var(--color-background) 48%, transparent) 25%,
          color-mix(in oklch, var(--color-background) 40%, transparent) 60%,
          color-mix(in oklch, var(--color-background) 72%, transparent) 100%
        );
    }
  }

  /* Desktop */
  @media (min-width: 768px) {
    .atrium-layer-soft-focus {
      mask-image: radial-gradient(
        ellipse 42% 48% at 20% 45%,
        rgba(0, 0, 0, 0.78) 0%,
        rgba(0, 0, 0, 0.28) 55%,
        transparent 82%
      );
      -webkit-mask-image: radial-gradient(
        ellipse 42% 48% at 20% 45%,
        rgba(0, 0, 0, 0.78) 0%,
        rgba(0, 0, 0, 0.28) 55%,
        transparent 82%
      );
    }

    /* Na tela inicial (video), foco restrito ao centro-esquerdo para dar total destaque à imagem/vídeo */
    #corporate-backdrop[data-atrium-stage="video"] .atrium-layer-soft-focus {
      mask-image: radial-gradient(
        ellipse 30% 38% at 15% 50%,
        rgba(0, 0, 0, 0.55) 0%,
        rgba(0, 0, 0, 0.15) 55%,
        transparent 78%
      );
      -webkit-mask-image: radial-gradient(
        ellipse 30% 38% at 15% 50%,
        rgba(0, 0, 0, 0.55) 0%,
        rgba(0, 0, 0, 0.15) 55%,
        transparent 78%
      );
    }

    .atrium-vignette {
      background:
        /* Proteção suave do cabeçalho */
        linear-gradient(
          180deg,
          color-mix(in oklch, var(--color-background) 60%, transparent) 0%,
          transparent 120px
        ),
        /* Foco de leitura discreto à esquerda */
        radial-gradient(
          ellipse 44% 50% at 20% 45%,
          color-mix(in oklch, var(--color-background) 52%, transparent) 0%,
          color-mix(in oklch, var(--color-background) 22%, transparent) 55%,
          transparent 85%
        ),
        linear-gradient(
          90deg,
          color-mix(in oklch, var(--color-background) 46%, transparent) 0%,
          color-mix(in oklch, var(--color-background) 14%, transparent) 38%,
          transparent 68%
        );
    }

    #corporate-backdrop[data-atrium-stage="video"] .atrium-vignette {
      background:
        linear-gradient(
          180deg,
          color-mix(in oklch, var(--color-background) 45%, transparent) 0%,
          transparent 100px
        ),
        radial-gradient(
          ellipse 32% 40% at 15% 50%,
          color-mix(in oklch, var(--color-background) 35%, transparent) 0%,
          transparent 72%
        );
    }
  }

  @media (forced-colors: active) {
    #corporate-backdrop {
      display: none;
    }
  }
</style>
