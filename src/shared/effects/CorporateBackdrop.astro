---
/**
 * CorporateBackdrop V2 — Átrio Desfocado em Tela Cheia (Full-Viewport 3 Camadas Ópticas)
 *
 * Preenche TODO o background da página (fixed inset-0), mudando dinamicamente
 * conforme a página ativa:
 * - Início (/): Vídeo 1405430.mp4
 * - Sobre (/sobre): Imagem 902085
 * - Projetos (/projetos): Imagem 1396090
 * - Contato (/contato): Imagem 607758
 *
 * Camada 1: Difusão Óptica Central (Bokeh — blur(22px) saturate(0.88) contrast(1.06))
 * Camada 2: Moldura Estrutural Periférica (blur(4px) + máscara elíptica radial que mantém o centro limpo e as bordas vivas)
 * Camada 3: Scrim de Leitura (.atrium-vignette — color-mix dinâmico com --color-background da página)
 */
import {
  PHOTO_CHROME_SURFER_SET,
  PHOTO_HALFTONE_DARK_SET,
  PHOTO_AKIRA_BIKE_SET,
  PHOTO_MOEBIUS_TRUSS_SET,
  VIDEO_FEATURED_STAGE,
} from '../media/frontImages';

interface Props {
  stage: 'video' | '902085' | '1396090' | '607758';
}

const { stage } = Astro.props;

const stageImageMap = {
  video: PHOTO_CHROME_SURFER_SET,
  '902085': PHOTO_HALFTONE_DARK_SET,
  '1396090': PHOTO_AKIRA_BIKE_SET,
  '607758': PHOTO_MOEBIUS_TRUSS_SET,
} as const;

const activeSet = stageImageMap[stage];
---

<div
  id="corporate-backdrop"
  data-atrium-stage={stage}
  class="pointer-events-none fixed inset-0 z-0 select-none overflow-hidden"
  aria-hidden="true"
>
  <!-- Camada 1: Difusão Óptica Central em Tela Cheia (Bokeh 22px da imagem/vídeo da página) -->
  <div class="atrium-layer-bokeh absolute inset-0 h-full w-full">
    {stage === 'video' ? (
      <video
        autoplay
        muted
        loop
        playsinline
        poster={activeSet.avif}
        class="atrium-image-bokeh h-full w-full object-cover object-center"
      >
        <source src={VIDEO_FEATURED_STAGE} type="video/mp4" />
      </video>
    ) : (
      <picture class="contents">
        <source media="(max-width: 767px)" srcset={activeSet.mobileAvif} type="image/avif" />
        <source media="(max-width: 767px)" srcset={activeSet.mobileWebp} type="image/webp" />
        <source srcset={activeSet.avif} type="image/avif" />
        <source srcset={activeSet.webp} type="image/webp" />
        <img
          src={activeSet.src}
          alt=""
          width="1280"
          height="720"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="atrium-image-bokeh h-full w-full object-cover object-center"
        />
      </picture>
    )}
  </div>

  <!-- Camada 2: Moldura Estrutural Periférica em Tela Cheia (blur 4px + máscara radial elíptica) -->
  <div class="atrium-layer-structural absolute inset-0 h-full w-full">
    {stage === 'video' ? (
      <video
        autoplay
        muted
        loop
        playsinline
        poster={activeSet.avif}
        class="atrium-image h-full w-full object-cover object-center"
      >
        <source src={VIDEO_FEATURED_STAGE} type="video/mp4" />
      </video>
    ) : (
      <picture class="contents">
        <source media="(max-width: 767px)" srcset={activeSet.mobileAvif} type="image/avif" />
        <source media="(max-width: 767px)" srcset={activeSet.mobileWebp} type="image/webp" />
        <source srcset={activeSet.avif} type="image/avif" />
        <source srcset={activeSet.webp} type="image/webp" />
        <img
          src={activeSet.src}
          alt=""
          width="1280"
          height="720"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="atrium-image h-full w-full object-cover object-center"
        />
      </picture>
    )}
  </div>

  <!-- Camada 3: Scrim de Leitura Dinâmico (.atrium-vignette calibrado com --color-background) -->
  <div class="atrium-vignette absolute inset-0"></div>
</div>

<style>
  #corporate-backdrop {
    contain: layout paint size;
    opacity: 0.92;
    mix-blend-mode: normal;
  }

  .atrium-image-bokeh {
    filter: blur(22px) saturate(0.92) contrast(1.06);
    transform: scale(1.06);
  }

  .atrium-layer-structural {
    mask-image: radial-gradient(
      ellipse 56% 52% at 38% 50%,
      rgba(0, 0, 0, 0.16) 0%,
      rgba(0, 0, 0, 0.58) 54%,
      rgba(0, 0, 0, 0.98) 92%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 56% 52% at 38% 50%,
      rgba(0, 0, 0, 0.16) 0%,
      rgba(0, 0, 0, 0.58) 54%,
      rgba(0, 0, 0, 0.98) 92%
    );
  }

  .atrium-image {
    filter: blur(3.5px) saturate(0.95) contrast(1.06);
    transform: scale(1.02);
  }

  .atrium-vignette {
    background:
      radial-gradient(
        ellipse 60% 56% at 36% 50%,
        color-mix(in oklch, var(--color-background) 82%, transparent) 0%,
        color-mix(in oklch, var(--color-background) 56%, transparent) 60%,
        color-mix(in oklch, var(--color-background) 24%, transparent) 100%
      ),
      linear-gradient(
        90deg,
        color-mix(in oklch, var(--color-background) 84%, transparent) 0%,
        color-mix(in oklch, var(--color-background) 52%, transparent) 48%,
        color-mix(in oklch, var(--color-background) 18%, transparent) 100%
      );
  }

  @media (forced-colors: active) {
    #corporate-backdrop {
      display: none;
    }
  }
</style>
