---
/**
 * CorporateBackdrop V2 — Átrio em Tela Cheia com Alta Visibilidade e Foco Seletivo
 *
 * Preenche TODO o background da página (fixed inset-0), mantendo a arte/vídeo
 * perfeitamente visível e nítida na maior parte da tela, com desfoque suave
 * apenas na zona de leitura à esquerda:
 * - Início (/): Vídeo 1405430.mp4
 * - Sobre (/sobre): Imagem 902085
 * - Projetos (/projetos): Imagem 1396090
 * - Contato (/contato): Imagem 607758
 *
 * Camada 1: Arte Base Nítida em Tela Cheia (blur(0px) — 100% visível na metade direita e periferia)
 * Camada 2: Lente Óptica de Difusão Suave (blur(8px) com máscara radial/direcional restrita à zona do texto)
 * Camada 3: Scrim de Leitura Leve (.atrium-vignette — protege apenas o contraste da tipografia sem esconder o fundo)
 */
import {
  PHOTO_CHROME_SURFER_SET,
  PHOTO_HALFTONE_DARK_SET,
  PHOTO_AKIRA_BIKE_SET,
  PHOTO_MOEBIUS_TRUSS_SET,
  VIDEO_FEATURED_STAGE,
} from '../media/frontImages';

interface Props {
  stage: 'video' | '902085' | '1396090' | '607758';
}

const { stage } = Astro.props;

const stageImageMap = {
  video: PHOTO_CHROME_SURFER_SET,
  '902085': PHOTO_HALFTONE_DARK_SET,
  '1396090': PHOTO_AKIRA_BIKE_SET,
  '607758': PHOTO_MOEBIUS_TRUSS_SET,
} as const;

const activeSet = stageImageMap[stage];
---

<div
  id="corporate-backdrop"
  data-atrium-stage={stage}
  class="pointer-events-none fixed inset-0 z-0 select-none overflow-hidden"
  aria-hidden="true"
>
  <!-- Camada 1: Arte/Vídeo Nítido em Tela Cheia (Totalmente visível no plano de fundo) -->
  <div class="atrium-layer-sharp absolute inset-0 h-full w-full">
    {stage === 'video' ? (
      <video
        autoplay
        muted
        loop
        playsinline
        poster={activeSet.avif}
        class="atrium-media-sharp h-full w-full object-cover object-center"
      >
        <source src={VIDEO_FEATURED_STAGE} type="video/mp4" />
      </video>
    ) : (
      <picture class="contents">
        <source media="(max-width: 767px)" srcset={activeSet.mobileAvif} type="image/avif" />
        <source media="(max-width: 767px)" srcset={activeSet.mobileWebp} type="image/webp" />
        <source srcset={activeSet.avif} type="image/avif" />
        <source srcset={activeSet.webp} type="image/webp" />
        <img
          src={activeSet.src}
          alt=""
          width="1280"
          height="720"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="atrium-media-sharp h-full w-full object-cover object-center"
        />
      </picture>
    )}
  </div>

  <!-- Camada 2: Difusão Óptica Seletiva (Desfoque suave restrito apenas à zona de leitura) -->
  <div class="atrium-layer-soft-focus absolute inset-0 h-full w-full">
    {stage === 'video' ? (
      <video
        autoplay
        muted
        loop
        playsinline
        poster={activeSet.avif}
        class="atrium-media-soft h-full w-full object-cover object-center"
      >
        <source src={VIDEO_FEATURED_STAGE} type="video/mp4" />
      </video>
    ) : (
      <picture class="contents">
        <source media="(max-width: 767px)" srcset={activeSet.mobileAvif} type="image/avif" />
        <source media="(max-width: 767px)" srcset={activeSet.mobileWebp} type="image/webp" />
        <source srcset={activeSet.avif} type="image/avif" />
        <source srcset={activeSet.webp} type="image/webp" />
        <img
          src={activeSet.src}
          alt=""
          width="1280"
          height="720"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="atrium-media-soft h-full w-full object-cover object-center"
        />
      </picture>
    )}
  </div>

  <!-- Camada 3: Scrim Direcional Leve (.atrium-vignette — mantém o fundo claro/visível) -->
  <div class="atrium-vignette absolute inset-0"></div>
</div>

<style>
  #corporate-backdrop {
    contain: layout paint size;
    opacity: 1;
    mix-blend-mode: normal;
  }

  /* Camada 1: Nítida e viva em toda a tela */
  .atrium-media-sharp {
    filter: blur(0px) saturate(1.04) contrast(1.04);
    transform: scale(1);
  }

  /* Camada 2: Desfoque suave (7px) aplicado apenas onde há concentração de texto */
  .atrium-layer-soft-focus {
    mask-image: radial-gradient(
      ellipse 46% 52% at 24% 50%,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.35) 55%,
      transparent 85%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 46% 52% at 24% 50%,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.35) 55%,
      transparent 85%
    );
  }

  .atrium-media-soft {
    filter: blur(7px) saturate(1.02) contrast(1.04);
    transform: scale(1.01);
  }

  /* Camada 3: Vinheta leve apenas atrás da coluna de leitura, deixando a arte livre no restante da tela */
  .atrium-vignette {
    background:
      radial-gradient(
        ellipse 48% 55% at 24% 50%,
        color-mix(in oklch, var(--color-background) 62%, transparent) 0%,
        color-mix(in oklch, var(--color-background) 28%, transparent) 58%,
        transparent 90%
      ),
      linear-gradient(
        90deg,
        color-mix(in oklch, var(--color-background) 58%, transparent) 0%,
        color-mix(in oklch, var(--color-background) 22%, transparent) 42%,
        transparent 75%
      );
  }

  @media (forced-colors: active) {
    #corporate-backdrop {
      display: none;
    }
  }
</style>
